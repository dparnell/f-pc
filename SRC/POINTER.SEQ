\ POINTER.SEQ   External memory allocation and management   F-PC native port

\ A POINTER is a named block of heap memory, allocated the first time the
\ name is executed. The original allocated paragraphs from DOS and compacted
\ them when one was freed; natively the blocks come from ALLOCATE.

\ BODY          +0              +4      +8              +12
\               [ address ]     [ link ][ size_bytes ]  [ verify ]

: POINTER       ( dbl_bytes | name -- )         \ make a pointer "name"
                ( -- addr )                     \ its location
                160 0 DMAX DROP                 \ at least 160 bytes
                CREATE 0 ,                      \ initialize to unallocated
                HERE  PHEAD @ ,  PHEAD !        \ link into chain
                ,                               \ lay in size in bytes
                PHEAD @ ,                       \ POINTER CHAIN verify word
                DOES>   DUP @ ?DUP IF  NIP EXIT  THEN   \ already allocated
                        DUP>R 8 + @ ALLOCATE
                        IF      DROP 0
                        ELSE    DUP R@ !
                        THEN    R>DROP ;

: ?VALID_POINTER ( plink -- plink )     \ check for valid pointer sturcture
                 DUP 8 + @ OVER <>
                 IF      CELL- BODY> DUP CR HEX U. YDP @
                         IF     DUP >NAME .ID
                         THEN   DROP
                         ." is NOT a valid POINTER structure!"
                         ABORT
                 THEN    ;

: %UNPOINTER    ( cfa -- )      \ deallocate pointer given the cfa
                >BODY DUP @
                IF      DUP CELL+ ?VALID_POINTER DROP
                        DUP @ FREE DROP  0 OVER !
                THEN    DROP ;

: UNPOINTER>    ( name -- )     \ deallocate a pointer name following
                ' STATE @
                IF      COMPILE (LIT) X, COMPILE %UNPOINTER
                ELSE    %UNPOINTER
                THEN    ; IMMEDIATE

: 0POINTERS     ( -- )                  \ free every allocated pointer
                PHEAD @                         \ beginning of pointer chain
                BEGIN   DUP                     \ while not a list end
                WHILE   ?VALID_POINTER
                        DUP CELL- @ ?DUP IF FREE DROP THEN
                        0 OVER CELL- !          \ clear pointer
                        @                       \ indirect to next ptr
                REPEAT  DROP ;

: %SIZEOF!      ( dbl_bytes cfa -- )    \ set the size of pointer "cfa"
                >R DROP R> >BODY CELL+ ?VALID_POINTER CELL+ ! ;

: SIZEOF!>      ( dbl_bytes | name -- ) \ set size of the following pointer
                ' STATE @
                IF      COMPILE (LIT) X, COMPILE %SIZEOF!
                ELSE    %SIZEOF!
                THEN    ; IMMEDIATE

: %SIZEOF@      ( cfa -- dbl_bytes )    \ get the size of pointer "cfa"
                >BODY CELL+ ?VALID_POINTER CELL+ @ 0 ;

: SIZEOF@>      ( -<name>- dbl_bytes )  \ get size of the following pointer
                ' STATE @
                IF      COMPILE (LIT) X, COMPILE %SIZEOF@
                ELSE    %SIZEOF@
                THEN    ; IMMEDIATE
