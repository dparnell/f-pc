\ EMMEXEC.SEQ   Shell to the host operating system            F-PC native port

\ The original shrank F-PC, swapped it to EMS or disk and EXECed
\ COMMAND.COM. Natively, <EXTEXEC> runs the command line in EXEC$ through
\ the host shell; F-PC stays where it is.

VARIABLE USE-DISK               \ kept for compatibility; unused
VARIABLE DSK-STATUS     TRUE DSK-STATUS !

: DISKON        ( -- )          USE-DISK ON ;
: DISKOFF       ( -- )          USE-DISK OFF  DSK-STATUS ON ;

CREATE EXEC$      $100 ALLOT    \ the command line: count byte, text
EXEC$ $100 ERASE
CREATE EXEC.PARAM $10  ALLOT    \ the EXEC parameter array (unused)
EXEC.PARAM $10 ERASE
CREATE CMDPATH    ," /bin/sh" 0 , $40 ALLOT

BUILTIN SYSTEM          ( addr len -- return-code )     \ run via the host shell

: <EXTEXEC>     ( --- return-code )     \ shell out with the command in EXEC$
                EXEC$ COUNT SYSTEM ;
