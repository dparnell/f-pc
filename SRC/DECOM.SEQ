\ DECOM.SEQ     The F-PC decompiler         Enhancements by Tom Zimmer
\                                                       F-PC native port

\    A Forth decompiler is a utility program that translates
\ executable forth code back into source code.  Normally this is
\ impossible, since traditional compilers produce more object
\ code than source, but in Forth it is quite easy.  The decompiler
\ is almost one to one, failing only to correctly decompile the
\ various Forth control stuctures and special compiling words.
\ It was written with modifiability in mind, so if you add your
\ own special compiling words, it will be easy to change the
\ decompiler to include them.  This code is highly implementation
\ dependant, and will NOT work on other Forth system.  To invoke
\ the decompiler, use the word SEE <name> where <name> is the
\ name of a Forth word.

ONLY FORTH ALSO DEFINITIONS HIDDEN ALSO

0 value showbase                \ base to use while showing a number

: DECOM.        ( n1 -- )       \ display number n1 in a selected base
                save> base
                showbase ?dup
                if      27 min 2 max base !
                then    base @ $0A =
                if      .
                else    u.
                then
                restore> base ;

: 0TAB          ( -- )          \ left margin goes to left edge of screen
                0 LMARGIN ! ;

: +TAB          ( --- )
                LMARGIN @ TABSIZE @ + DUP LMARGIN !
                RMARGIN @ TABSIZE @ - >
                IF      TABSIZE @ LMARGIN !
                THEN    ;

: -TAB          ( --- )
                LMARGIN @ TABSIZE @ - 0MAX DUP LMARGIN !
                TABSIZE @ <
                IF      RMARGIN @ TABSIZE @ - 0MAX LMARGIN !
                THEN    ;

: CRTAB         RMARGIN @ ?LINE ;

ONLY FORTH ALSO HIDDEN DEFINITIONS ALSO

headerless

 0 VALUE DECOMSEG      \ native port: the list address being shown;
                        \ IPs (and PFASAV) are absolute list addresses
 0 VALUE ?DEBUG
19 VALUE SPLIT-L#
19 VALUE SCROLL-L#
 0 value PREVLIST

: SRCEEOLCR    EEOL CRLF ;

: MAX-SPLIT     ( -- n1 )
                ROWS 4 - ;

: INIT-SPLIT    ( --- )         \ initialize the split line as 6 lines up
                DEFERS INITSTUFF
                ROWS DUP 4 / - DUP =: SPLIT-L# =: SCROLL-L# ;

' INIT-SPLIT IS INITSTUFF

: DECOMSEG@     ( IP --- n1 )   \ IP is an absolute list address now
                @ ;

: ASSOCIATIVE:
   CONSTANT
   DOES>         ( N -- INDEX )
      DUP @ ( N PFA CNT )   -ROT DUP @ 0 ( CNT N PFA CNT 0 )
      DO   CELL+   2DUP @ = ( CNT N PFA' BOOL )
         IF 2DROP DROP   I 0 0   LEAVE   THEN
            ( CLEAR STACK AND RETURN INDEX THAT MATCHED )
      LOOP   2DROP   ;

: .WORD         ( IP -- IP' )
                DUP DECOMSEG@ >NAME DUP C@ 64 AND
                IF      DUP C@ 31 AND 10 + ?LINE
                        ." [COMPILE] "
                THEN    DROP DUP DECOMSEG@ >NAME.ID   CELL+   ;

\ Native port: tokens and in-line operands are cells, branch targets are
\ absolute list addresses, and in-line strings are counted strings padded
\ to a cell boundary.

: (LIT+)        ( IP -- IP' )    6 ?LINE 2 CELLS + ;

: .LIT          ( IP -- IP' )    (LIT+) DUP CELL- DECOMSEG@ DECOM. ;

: .[']          ( IP -- IP' )    CRTAB ." ['] " CELL+ ;

: .IS           ( IP -- IP' )    ." IS " CELL+ ;

: .IF           ( IP -- IP' )    CRTAB ." IF " (LIT+) TAB +TAB ;

: .ELSE         ( IP -- IP' )    -TAB CRTAB ." ELSE " (LIT+) TAB +TAB ;

: .CASE         ( IP -- IP' )    CRTAB ." CASE " CELL+ TAB ;

: .OF           ( IP -- IP' )    CRTAB ." OF " (LIT+) TAB +TAB ;

: .ENDOF        ( IP -- IP' )    -TAB CRTAB ." ENDOF " (LIT+) TAB ;

: .ENDCASE      ( IP -- IP' )    CRTAB ." ENDCASE " CELL+ TAB ;

: .DO           ( IP -- IP' )    CRTAB ." DO  " (LIT+) TAB +TAB ;

: .?DO          ( IP -- IP' )    CRTAB ." ?DO  " (LIT+) TAB +TAB ;

: .LOOP         ( IP -- IP' )    -TAB CRTAB ." LOOP " (LIT+) TAB ;

: .+LOOP        ( IP -- IP' )    -TAB CRTAB ." +LOOP " (LIT+) TAB ;

: .WHILE        ( IP -- IP' )    -TAB CRTAB ." WHILE " (LIT+) TAB +TAB ;

: .REPEAT       ( IP -- IP' )    -TAB CRTAB ." REPEAT " (LIT+) TAB ;

: .UNTIL        ( IP -- IP' )    -TAB CRTAB ." UNTIL " (LIT+) TAB ;

: .AGAIN        ( IP -- IP' )    -TAB CRTAB ." AGAIN " (LIT+) TAB ;

: .BEGIN        ( IP -- IP' )    CRTAB CELL+ ." BEGIN " TAB +TAB ;

: .THEN         ( IP -- IP' )    -TAB CRTAB CELL+ ." THEN " TAB ;

: .NEXT         ( IP -- IP' )    CRTAB ." NEXT " (LIT+) TAB ;
                                \ NEXT| (FOR ... NEXT), new in the port

: .QUOTE        ( IP -- IP' )    .WORD   .WORD ;

                \ Print the in-line counted string at a1, and return the
                \ cell aligned address after it. Prepend a " space, and
                \ append a " space to the string
: ."X$"         ( A1 --- A2 )
                '"' FEMIT SPACE
                COUNT 2DUP TYPE + ALIGNED '"' FEMIT SPACE ;

: .STRING."     ( IP -- IP' )
                CELL+ DUP C@ 5 + ?LINE
                '.' FEMIT ."X$" ;

: .STRING"      ( IP -- IP' )   \ (") has an in-line string now
                CELL+ DUP C@ 4 + ?LINE
                ."X$" ;

: .STRING""     ( IP -- IP' )
                CELL+ DUP C@ 5 + ?LINE
                '"' FEMIT ."X$" ;

: .ABORT"       ( IP -- IP' )
                CELL+ DUP C@ 10 + ?LINE
                ." ABORT" ."X$" ;

: .(DOES>)      ( IP -- IP' )   \ (DOES>) is followed by the clause's
                                \ code token; the clause's list follows.
                CRTAB ." DOES> " 2 CELLS + ;

: .FLIT        ( IP -- IP' )   \ (FLIT) is followed by an 8 byte float
                CELL+ DUP F@ PAD 1+ 30 (F.) PAD C!
                PAD COUNT 'e' SCAN NIP 0= >R    \ no exponent: add one
                PAD C@ R@ 2* + ?LINE
                PAD COUNT TYPE R> IF ." E0" THEN SPACE  2 CELLS + ;

: .UNNEST     ( IP -- IP' )
                ." ; "   DROP   0   ;

: .FINISH     ( IP -- IP' )
                .WORD   DROP   0   ;

28 ASSOCIATIVE: EXECUTION-CLASS
   (  0 ) '   (LIT)        ,         (  1 ) '   ?BRANCH      ,
   (  2 ) '   BRANCH       ,         (  3 ) '   (LOOP)       ,
   (  4 ) '   (+LOOP)      ,         (  5 ) '   (DO)         ,
   (  6 ) '   COMPILE      ,         (  7 ) '   (.")         ,
   (  8 ) '   (ABORT")     ,         (  9 ) '   (DOES>)      ,
   ( 10 ) '   UNNEST       ,         ( 11 ) '   (")          ,
   ( 12 ) '   (?DO)        ,         ( 13 ) '   NEXT|        ,
   ( 14 ) '   ?UNTIL       ,         ( 15 ) '   ?WHILE       ,
   ( 16 ) '   DOAGAIN      ,         ( 17 ) '   DOREPEAT     ,
   ( 18 ) '   DOBEGIN      ,         ( 19 ) '   DOTHEN       ,
   ( 20 ) '   (X")         ,         ( 21 ) '   <'>          ,
   ( 22 ) '   (IS)         ,         ( 23 ) '   (OF)         ,
   ( 24 ) '   DOENDOF      ,         ( 25 ) '   DOCASE       ,
   ( 26 ) '   DOENDCASE    ,         ( 27 ) '   (FLIT)       ,

: .EXECUTION-CLASS      ( N1 --- )
                0MAX 28 MIN EXEC:
                (  0 )     .LIT         (  1 )     .IF
                (  2 )     .ELSE        (  3 )     .LOOP
                (  4 )     .+LOOP       (  5 )     .DO
                (  6 )     .QUOTE       (  7 )     .STRING."
                (  8 )     .ABORT"      (  9 )     .(DOES>)
                ( 10 )     .UNNEST      ( 11 )     .STRING"
                ( 12 )     .?DO         ( 13 )     .NEXT
                ( 14 )     .UNTIL       ( 15 )     .WHILE
                ( 16 )     .AGAIN       ( 17 )     .REPEAT
                ( 18 )     .BEGIN       ( 19 )     .THEN
                ( 20 )     .STRING""    ( 21 )     .[']
                ( 22 )     .IS          ( 23 )     .OF
                ( 24 )     .ENDOF       ( 25 )     .CASE
                ( 26 )     .ENDCASE     ( 27 )     .FLIT
                ( 28 )     .WORD      ;

\ Native port: the VM's seed interpreter compiled the kernel's first
\ definitions with its own built-in (") (.") (ABORT") etc., which the
\ kernel later redefines under the same names. Map such shadowed xts to
\ the current word of the same name, so both decompile alike.

32 CONSTANT MAX-SHADOWS
CREATE SHADOWS  MAX-SHADOWS 2* CELLS ALLOT      \ pairs: new, old
VARIABLE #SHADOWS

: CANON         ( xt -- xt' )   \ the current version of a shadowed xt
                #SHADOWS @ 0
                ?DO     DUP SHADOWS I 2* CELLS + 2@ >R =
                        IF      DROP R>
                        ELSE    R>DROP
                        THEN
                LOOP    ;

: NAME>HERE     ( nfa -- a1 )   \ the name as a plain counted string
                HERE 32 CMOVE
                $C0 HERE CRESET                 \ real count only
                $80 HERE COUNT + 1- CRESET      \ last char's high bit
                BL HERE COUNT + C! HERE ;

: ?SHADOW       ( lfa -- )
                DUP LINK> SWAP L>NAME NAME>HERE FIND    ( cfa cfa' f )
                IF      2DUP <> OVER EXECUTION-CLASS 27 < AND
                        #SHADOWS @ MAX-SHADOWS < AND
                        IF      SHADOWS #SHADOWS @ 2* CELLS + 2!
                                #SHADOWS INCR EXIT
                        THEN
                THEN    2DROP ;

: FIND-SHADOWS  ( -- )
                #SHADOWS OFF
                ['] FORTH-VOC >IS @ >BODY
                #THREADS 0
                DO      DUP I CELLS + @
                        BEGIN   ?DUP
                        WHILE   DUP ?SHADOW @
                        REPEAT
                LOOP    DROP ;

FIND-SHADOWS

0 VALUE PFALINE
0 VALUE DIDPFA
0 VALUE TOPCRS
0 VALUE DUMMYCRS
0 VALUE #EMPTY

: TOPCR         ( --- )
                DUMMYCRS
        IF      DECR> DUMMYCRS
                OFF> #OUT
        ELSE    #LINE @ SPLIT-L# 2- >=
                IF      SPLIT-L# 1- SAVE!> ROWS \ save ROWS and set to split
                        0 2 AT                  \ move to third line
                        -LINE                   \ scroll upper portion
                        RESTORE> ROWS           \ restore ROWS
                        0 SPLIT-L# 2- AT        \ move to split line
                ELSE    SRCEEOLCR
                THEN
        THEN    INCR> TOPCRS ;

: .LIST         ( LIST-ADDR -- ) \ decompile the token list at list-addr
                DUP PREVLIST <>                 \ reset when new definition
                IF      OFF> #EMPTY
                        DUP !> PREVLIST
                THEN
                DUP =: DECOMSEG         \ IPs are absolute list addresses
                SAVESTATE
                0TAB +TAB
                COLS 10 - RMARGIN !
                #LINE @ =: TOPCRS
                SAVE> CR
                ?DEBUG
                IF      ['] TOPCR IS CR
                        #EMPTY =: DUMMYCRS
                THEN
                OFF> PFALINE
                OFF> DIDPFA
                BEGIN   ?CR
                        DUP PFASAV @ OVER = ?DEBUG AND
                        IF      >ATTRIB4 ON> ?DEFATTRIB
                                TOPCRS =: PFALINE
                                PFALINE SPLIT-L# 4 - 0MAX - 0MAX !> #EMPTY
                                ON> DIDPFA
                        THEN
                        DECOMSEG@ CANON EXECUTION-CLASS .EXECUTION-CLASS >NORM
                        OFF> ?DEFATTRIB
                        DUP 0= KEY? OR
                        OVER XHERE U< 0= OR     \ ran off the end of list space
                        ?DEBUG
                        IF
                                #LINE @ SPLIT-L# 2- >=  \ hit bottom
                                TOPCRS pfaline 3 + > and
                                didpfa and
                                IF      drop true
                                THEN
                        THEN
                UNTIL   DROP
                RESTORE> CR
                RESTORESTATE ;

: .PFA          ( CFA -- )      \ decompile a colon definition's list
                >BODY @ .LIST ;

: .IMMEDIATE   ( CFA -- )
                >NAME C@ 64 AND
                IF      ." IMMEDIATE"   THEN   ;

: .CONSTANT     ( CFA -- )
                DUP >BODY ?   ." CONSTANT "   >NAME.ID   ;

: .VALUE        ( CFA -- )
                DUP >BODY ?   ." VALUE "      >NAME.ID   ;

: .VARIABLE     ( CFA -- )
                DUP >BODY .   ." VARIABLE "   DUP >NAME.ID
                ." Value = " >BODY ? ;

: .:            ( CFA -- )
                ." : "  DUP >NAME .ID CR TAB .PFA   ;

\ A DOES> clause's code token says nothing about where its list is, so
\ find the "(DOES>) token" pair that DOES> compiled in front of it, by
\ scanning list space down from XHERE (lists are cell aligned).
: DOES-LIST     ( ct -- list-addr | 0 )
                XHERE ALIGNED CELL-
                BEGIN   DUP LIMIT U>
                WHILE   2DUP @ =
                        IF      DUP CELL- @ ['] (DOES>) =
                                IF      NIP CELL+ EXIT
                                THEN
                        THEN    CELL-
                REPEAT  2DROP 0 ;

: .DOES>        ( CFA -- )
                @ DUP FIRST-DOES-CT =           \ the seed's VOCABULARY
                IF      DROP ." is a VOCABULARY " EXIT
                THEN    DOES-LIST ?DUP
                IF      DUP >.ID ." DOES> " .LIST
                ELSE    ." is a DOES> word (clause not found) "
                THEN    ;

: .USER-VARIABLE   ( CFA -- )
                DUP >BODY ?   ." USER VARIABLE "   DUP >NAME.ID
                ." Value = "   >IS  ?   ;


: .DEFER        ( CFA -- )
                ." DEFERRED " DUP >NAME.ID   ." IS "  >IS @ (SEE)  ;

: .USER-DEFER   ( cfa -- )
   ." USER DEFERRED "   DUP >NAME.ID  ." IS "  >IS @ (SEE)  ;

: .OTHER   ( CFA -- )
        DUP     >NAME.ID
        DUP DOES?                       \ Is this a DOES> word?
        IF      DROP .DOES>             EXIT
        THEN    2DROP   ." is a built-in primitive (in the VM)" ;

headers

7 CONSTANT MAX-CLASSES

\ classified by code token (CT-xxx) now
MAX-CLASSES ASSOCIATIVE: DEFINITION-CLASS
   ( 0 )   CT-NEST       ,   ( 1 )   CT-DOCONST     ,
   ( 2 )   CT-DOVAR      ,   ( 3 )   CT-DOUSER      ,
   ( 4 )   CT-DODEFER    ,   ( 5 )   CT-DOUSERDEFER ,
   ( 6 )   CT-DOVALUE    ,

: .DEFINITION-CLASS     ( N1 --- )
                0MAX MAX-CLASSES MIN EXEC:
                ( 0 )     .:            ( 1 )     .CONSTANT
                ( 2 )     .VARIABLE     ( 3 )     .USER-VARIABLE
                ( 4 )     .DEFER        ( 5 )     .USER-DEFER
                ( 6 )     .VALUE        ( 7 )     .OTHER      ;

: ((SEE))       ( Cfa -- )
                SAVE> ATTRIB
                CR   DUP DUP @
                DEFINITION-CLASS
                .DEFINITION-CLASS
                .IMMEDIATE
                RESTORE> ATTRIB ;

' ((SEE)) IS (SEE)

FORTH DEFINITIONS

: SEE           ( | name -- )
                '   (SEE) ;

