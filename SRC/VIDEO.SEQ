\ VIDEO.SEQ     Direct VIDEO Screen output              F-PC native port

\ The screen is a virtual text screen kept by the VM (char + attribute
\ cells). COLS ROWS and CROWS are set by the host from the terminal size and
\ follow it when the terminal is resized.

DECIMAL

BUILTIN ATTRIB          \ display attribute value
VARIABLE VMODE-VAR      \ Video mode save variable
VARIABLE BLANKING       \ Are we blanking during screen drawing?

BUILTIN COLS            \ Screen columns  (a VALUE)
BUILTIN ROWS            \ Screen rows     (a VALUE)
BUILTIN CROWS           \ Cursor DOT rows (a VALUE)

BUILTIN ?VMODE          ( -- n1 )       \ video mode (3 = colour text)

DEFER INITMONO  ' NOOP IS INITMONO      \ INITIALIZATION VECTOR AVAILABLE
DEFER INITCOLOR ' NOOP IS INITCOLOR     \ FOR MONOCHROME AND COLOR

: VMODE.SET     ( --- )
                ?VMODE DUP VMODE-VAR !  7 =
                IF      INITMONO
                ELSE    INITCOLOR
                THEN    ;

\ CGA snow suppression is not needed.
: BLANK.COLOR   ( --- ) ;
: SHOW.COLOR    ( --- ) ;

BUILTIN VIDEO-BUF       ( -- addr )     \ the screen: COLS*ROWS (char,attr) pairs
\ Laid out like PC text video memory (row stride COLS 2*). It moves when the
\ terminal is resized, so fetch it each time rather than keeping it.
BUILTIN BIOS-VIDEO      ( ax bx cx dx -- ax bx cx dx )  \ INT 10h emulation
BUILTIN AT-XY           ( x y -- )      \ move the cursor
BUILTIN GET-XY          ( -- x y )      \ where the cursor is
BUILTIN REFRESH         ( -- )          \ show screen changes now
BUILTIN SHIFT-STATE     ( -- flags )    \ keyboard shift flags (INT 16h AH=2)

DEFER RESIZED   ' NOOP IS RESIZED
\ Run after the terminal (and so COLS ROWS VIDEO-BUF) changed size. Add to
\ it to re-layout and redraw; KEY then returns K-RESIZE.
130 CONSTANT K-RESIZE   \ BIOS value $0200: scan 2 never comes from a real key
