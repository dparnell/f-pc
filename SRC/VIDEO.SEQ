\ VIDEO.SEQ     Direct VIDEO Screen output              F-PC native port

\ The screen is a virtual text screen kept by the VM (char + attribute
\ cells). COLS ROWS and CROWS are set by the host from the terminal size and
\ follow it when the terminal is resized.

DECIMAL

BUILTIN ATTRIB          \ display attribute value
VARIABLE VMODE-VAR      \ Video mode save variable
VARIABLE BLANKING       \ Are we blanking during screen drawing?

BUILTIN COLS            \ Screen columns  (a VALUE)
BUILTIN ROWS            \ Screen rows     (a VALUE)
BUILTIN CROWS           \ Cursor DOT rows (a VALUE)

BUILTIN ?VMODE          ( -- n1 )       \ video mode (3 = colour text)

DEFER INITMONO  ' NOOP IS INITMONO      \ INITIALIZATION VECTOR AVAILABLE
DEFER INITCOLOR ' NOOP IS INITCOLOR     \ FOR MONOCHROME AND COLOR

: VMODE.SET     ( --- )
                ?VMODE DUP VMODE-VAR !  7 =
                IF      INITMONO
                ELSE    INITCOLOR
                THEN    ;

\ CGA snow suppression is not needed.
: BLANK.COLOR   ( --- ) ;
: SHOW.COLOR    ( --- ) ;
