\ SAVEEXE.SEQ   The save part of the SAVE-EXE mechanism     F-PC native port

\ SAVE-EXE now writes a VM system image, which "fpc -i name.IMG" starts
\ from. Images hold no machine code or host pointers. The default extension
\ is .IMG (the original forced .EXE).

handle exehcb

: <save-exe>    ( | name --- )
                DECIMAL                 \ Save system in DECIMAL number base
                more? 0=
                if      cr ." File to save? " query
                then
                exehcb !hcb " IMG" ">$
                exehcb $>ext
                exehcb >nam exehcb c@ (SAVE-IMAGE)
                abort" Write ERROR, Disk probably FULL!" ;

: save-exe      ( | name --- )
\+ behead       behead          \ remove beheadable words before save
                withheads on
                TRUE !> 1STCOLD         \ COLD re-initializes on load
                <save-exe> ;

' save-exe alias FSAVE ( | name --- )    \ a pseudonym for SAVE-EXE

: turnkey       ( | name --- )
\ Save an application image; BOOT should already run the application.
                withheads off
                TRUE !> 1STCOLD
                <save-exe>
                bye ;
