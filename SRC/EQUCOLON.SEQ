\ EQUCOLON.SEQ          words to modify VALUEs          F-PC native port

\ The %xx> runtime words take the following word in the definition as their
\ operand; they are VM built-ins.

BUILTIN %@>     ( --- n1 )      \ Fetch from the BODY of following word.
BUILTIN %!>     ( n1 --- )      \ Store to the BODY of following word.
BUILTIN %U@>    ( --- n1 )      \ Fetch the USER data of following word.
BUILTIN %U!>    ( n1 --- )      \ Store the USER data of following word.
BUILTIN %+!>    ( n1 --- )      \ Add n1 to the BODY of following word.
BUILTIN %INCR>  ( --- )         \ Increment the BODY of following word.
BUILTIN %DECR>  ( --- )         \ Decrement the BODY of following word.
BUILTIN %OFF>   ( --- )         \ Clear the BODY of following word.
BUILTIN %ON>    ( --- )         \ Set to -1 the BODY of following word.
BUILTIN %&>     ( -- a1 )       \ The BODY address of the following word.

: ?USER         ( a1 --- a1 f1 )
\ test a1, is it a user word, return TRUE if it is else FALSE.
                DUP @ DUP CT-DOUSER = SWAP CT-DOUSERDEFER = OR ;

: >IS           ( cfa -- data-address )
\ The address of the data of a VALUE, VARIABLE, DEFER or USER word.
                ?USER IF  >BODY @ UP @ +  ELSE  >BODY  THEN ;

: ?NOUSER       ( A1 --- A1 )
\ Test a1 to verify it is not a USER definition, if it is, abort.
                ?USER ABORT" Won't work on USER words." ;

: @>            ( | <name> --- n1 )
\ Fetch the BODY or USER contents of <name>.
                STATE @
                IF      ' ?USER
                        IF      COMPILE %U@>
                        ELSE    COMPILE %@>
                        THEN    X,
                ELSE    ' >IS @
                THEN    ; IMMEDIATE

: !>            ( n1 | <name> --- )
\ Store into the BODY or USER field of <name>.
\ The word "=:" is an alias of this word.
                STATE @
                IF      ' ?USER
                        IF      COMPILE %U!>
                        ELSE    COMPILE %!>
                        THEN    X,
                ELSE    ' >IS !
                THEN    ; IMMEDIATE

: +!>           ( n1 | <name> --- )
\ Increment the BODY or USER field of <name> by n1.
                ' ?NOUSER
                STATE @
                IF      COMPILE %+!> X,
                ELSE    >IS +!
                THEN    ; IMMEDIATE

: INCR>         ( | <name> --- )
                ' ?NOUSER
                STATE @
                IF      COMPILE %INCR> X,
                ELSE    >IS INCR
                THEN    ; IMMEDIATE

: DECR>         ( | <name> --- )
                ' ?NOUSER
                STATE @
                IF      COMPILE %DECR> X,
                ELSE    >IS DECR
                THEN    ; IMMEDIATE

: OFF>          ( | <name> --- )
                ' ?NOUSER
                STATE @
                IF      COMPILE %OFF> X,
                ELSE    >IS OFF
                THEN    ; IMMEDIATE

: ON>           ( | <name> --- )
                ' ?NOUSER
                STATE @
                IF      COMPILE %ON> X,
                ELSE    >IS ON
                THEN    ; IMMEDIATE

: &>            ( | <name> --- a1 )
\ Return the BODY address a1 of <name>, a VALUE or VARIABLE.
                ' ?NOUSER
                STATE @
                IF      COMPILE %&> X,
                ELSE    >IS
                THEN    ; IMMEDIATE
