\ TIMESTUF.SEQ          More words associated with timing       Tom Zimmer
\                                                       F-PC native port

: SEC-ELAPSED   ( --- N1 )    \ RETURN ELAPSED SECONDS < 18 HRS
                TIME-ELAPSED B>SEC ; ( -- N1 )

: 10TH-ELAPSED  ( --- N1 )
                TIME-ELAPSED 0 100 UM/MOD DROP 10 UM/MOD NIP ;

\ SECONDS and TENTHS wait with MS, which sleeps on the host (calling
\ PAUSE, so other tasks run) rather than busy-waiting on the clock.

DEFER PAUSE-FUNC        ' NOOP IS PAUSE-FUNC    \ unused now, kept for old code

: MS   ( n -- )                 \ wait n milliseconds: sleep on the host in
                                \ steps of at most 10, letting tasks run
                HOST-MS +
                begin   pause
                        dup HOST-MS - dup 0>
                while   10 min HOST-SLEEP
                repeat  2drop ;

: SECONDS       ( N1 --- )   \ PAUSE FOR N1 SECONDS
                0MAX 0 ?DO 1000 MS LOOP ;

: TENTHS        ( N1 --- )       \ PAUSE FOR N1 TENTHS OF A SECOND
                0MAX 100 * MS ;

: MINUTES       ( N1 --- )   \ PAUSE FOR N1 MINUTES
                0MAX   0 ?DO   60 SECONDS      LOOP ;

: HOURS         ( N1 --- )       \ PAUSE FOR N1 HOURS
                0MAX   0 ?DO   60 MINUTES      LOOP ;

: 0COMPILER     ( --- )
                TOTALLINES OFF
                TIME-RESET ;

: .COMPSTAT     ( --- )
                cr .elapsed
                cr ." Total lines compiled  = " totallines @ 5 u.r
                cr ." Compiled lines/minute = "
                totallines @ time-elapsed drop ( lines centiseconds )
                \ 32-bit cells: the original's 16-bit range juggling is
                \ not needed. LPM = lines * 6000 / centiseconds.
                ?dup 0=
                if      drop ." Too little time has elapsed to calculate LPM"
                else    6000 swap */ 5 u.r
                then    ;

: TILLKEY       ( N1 --- )      \ WAIT UP TO N1 SECONDS FOR A KEY THEN GO ON.
                KEY?    IF  DROP EXIT  THEN     \ LEAVE IF KEY PRESSED
                CR ."  Waiting, press SPACEBAR to continue.."
                0MAX 0
                ?DO     KEY?    ?LEAVE
                        1 SECONDS
                LOOP    KEY?
                IF      KEY 3 = ABORT" Quitting " THEN ;

