\ SEDCODE.SEQ   The Assembly code needed for SED        by Tom Zimmer
\                                                       F-PC native port

\
\   F-PC native port.  The CODE words of this file are high level Forth now.
\
\   SED's text memory, flat model (see also EDITSTUF.SEQ):
\
\   Text buffer   TSEGB .. TSEGB+#EDSEGS (bytes).  Each line is a counted
\                 string: a count byte (1..255) then the text INCLUDING its
\                 CR LF.  A line starts on a cell boundary and takes
\                 "count 1+ ALIGNED" bytes (the original used one paragraph
\                 per started 16 bytes; "1+ PARAGRAPH" becomes "1+ ALIGNED",
\                 one paragraph becomes one CELL).  The buffer is a gap
\                 buffer: lines 0 .. CURLINE-1 are packed upward from TSEGB
\                 to TOFF; lines CURLINE .. LASTLINE are packed against the
\                 top, the last one ending at TSEGB+#EDSEGS.  TEND is the
\                 address of line CURLINE.  The gap is TOFF .. TEND.
\
\   Line table    LSEG, an array of cells: entry n holds the ADDRESS of line
\                 n.  Entry LASTLINE+1 holds TSEGB+#EDSEGS (end sentinel).
\                 Line n's bytes are [ entry n , entry n+1 ) for n >= CURLINE.
\
\   "Line table addresses" (from >LINEPTR LINEPTR TL+ TL-) are absolute
\   addresses of table cells, so TL:@ TL:! TL:+! are just @ ! +!, TL: does
\   nothing, TL* is CELLS.  Step through the table with TL+ TL- TL*, never
\   with 2+ or 2*.  Code that used TL: to build seg:off pairs for CMOVEL
\   now passes the plain addresses to CMOVE / CMOVE>.
\

editor definitions

' noop  alias tl:       ( a1 -- a1 )    \ was ( a1 -- lseg a1 ); no segment now
' cell+ alias tl+       ( a1 --- a2 )   \ a2 = a1 + the list entry size in bytes
' cell- alias tl-       ( a1 --- a2 )   \ a2 = a1 - the list entry size in bytes
' cells alias tl*       ( n1 -- n2 )    \ n2 = n1 * the list entry size in bytes

BUILTIN getdiskfree     \ return free space from disk (DOS function 36h)
                ( dv --- avail.clusters bytes/sec secs/cluster )

: >lineptr      ( n1 --- a1 )   \ address of line n1's line table entry
                cells lseg + ;

: lineptr       ( --- a1 )      \ address of the current line's table entry
                curline cells lseg + ;

' @   alias tl:@        ( a1 -- n1 )
' !   alias tl:!        ( n adr -- )
' +!  alias tl:+!       ( n adr -- )

: endtst?       ( --- f1 )      \ true while there is room to read more lines
                lineptr tl- tl:@ tend u<
                curline maxlines 4 - < and ;    \ port: and room in the table

: rmsave        ( a1 --- a1 c1 )        \ fetch contents of a1 and returns
                                        \ as c1 and accumulate max as RMMAX
                dup c@ dup 2- rmmax max =: rmmax ;

: #lineseg      ( n1 --- a1 )   \ n1 = line, a1 = line address (count byte)
                cells lseg + @ ;

: window.left   ( --- n1 )      \ absolute left edge of window
                first.textcol 1- ;

: window.right  ( --- n1 )      \ absolute right edge of window.
                last.textcol 1+ ;

: text.width    ( --- n1 )      \ width of text portion of window
                last.textcol first.textcol - 1+ ;

: clipline      ( a1 n1 --- a2 n3 )     \ clip a line to the window
                swap winoff + swap              \ add window offset to address
                winoff - 0max                   \ subtract from length, >= 0
                text.width min ;                \ no longer than text.width

: len-accum     ( n1 --- n1 )   \ sum in byte length n1 to double file length
                dup 0 currentsize d+! ;         \ in double variable CURRENTSIZE

\ adjust the line pointer table lines n3 through n2-1 by n1 bytes.

: adj_ptr_lines ( n1 n2 n3 --- )
                >lineptr swap >lineptr swap     ( n1 a-limit a-start )
                begin   2dup u>
                while   2 pick over +!          \ add incrementer to entry
                        tl+                     \ bump to next entry
                repeat  2drop drop ;

forth definitions
