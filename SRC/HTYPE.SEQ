\ HTYPE.SEQ     Hyper Type, selectively erases or bolds text F-PC native port

\ Native port: TYPEL (type from another segment) is gone and TYPE does all
\ typing, so HYPERTYPE ( a1 n1 -- ) replaces TYPE while browsing, where
\ HYPERTYPEL used to replace TYPEL (which TYPE went through). NORMTYPE is
\ the TYPE in effect when this file was loaded; the original compiled that
\ with DEFERS TYPEL. It is also what the editor restores after browsing.

' type >is @ value normtype

: hypertype     ( a1 n1 --- )
                ?dosio if (type) exit then
                dup 0>
        if      over c@ hyperdest =                  \ (ø) 248 char
                if      1 /string
                        2dup bl scan nip over swap -
                        dup 1+ spaces /string
                then                            \ scan for hypertext char
                begin   2dup hyperchar scan nip ?dup
                                                \ if found, show following
                while   over >r - dup>r over >r \ word in reverse video
                        normtype execute
                        r> r> r> swap /string
                        space 1 /string         \ strip off hyperchar to
                        >rev
                        2dup bl scan nip
                        over >r - dup>r over >r
                        normtype execute
                        r> r> r> swap /string
                        >norm
                repeat  normtype execute
        else    2drop
        then    ;

\ ***************************************************************************
\ Words to insert the hyper text characters

: hsrcschr      ( --- )         \ mark the source of a hypertext link
                rchr lwrd
                hyperchar schr ;

\ 234 fnset hsrcschr              \ Alt-F3

: hdstschr      ( --- )         \ mark the destination of a hypertext link
                shoml
                true save!> imode
                hyperdest schr
                restore> imode ;

\ 236 fnset hdstschr              \ Alt-F5

