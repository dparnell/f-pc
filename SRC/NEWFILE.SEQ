\ NEWFILE.SEQ   Create a new file, and edit it.         F-PC native port

defined edit nip 0= #if \s #endif       \ stop loading if EDIT not defined

only forth also definitions hidden also

: newfile       ( t1 --- )      \ Open an existing file or CREATE a new one.
                bl word c@ 0=                       \ if no name on line
                if      cr ." Filename to create? "             \ prompt him
                        #out @ #line @ here dup off 24 lineeditor 0=
                        here c@ 0= or abort" No file specified"
                then    here
                seqhandle dup>r hclose drop         \ close any file open
                r@ $>handle                         \ move name to SEQHANDLE
                r@ hopen                            \ if we can't open it then
                if      r@ hcreate                  \ create the new file
                        abort" Create file FAILED"  \ abort if we can't
                        2573                        \ decimal for CRLF
                        sp@ 2 r@ hwrite 2drop       \ write an empty line
                        r@ hclose drop              \ update the directory
                        r@ hopen drop               \ for the new file
                else    ." \1 File already exists! "
                        1 seconds                   \ warn already exists
                then    r>drop
                0 edit ;                            \ enter editor

' newfile is makefile

' newfile alias sed             \ for compatibility with F-PC 2.25

\ F-PC native port: each user's F-PC.CFG lives in USER-DIR (normally
\ ~/.config/f-pc) and is loaded instead of the installed one.
handle ucfghndl

: copy-config   ( --- )         \ copy the F-PC.CFG in use to USER-DIR
                cfghndl $file                   \ the installed (or local) one
                if      ucfghndl hcreate abort" Can't create the config file"
                        ucfghndl hclose drop exit       \ none: start empty
                then
                seqhandle endfile drop dup allocate abort" No memory"
                0.0 seqhandle movepointer
                2dup swap seqhandle hread drop  ( n buf )
                ucfghndl hcreate abort" Can't create the config file"
                2dup swap ucfghndl hwrite drop
                ucfghndl hclose drop
                free 2drop ;

: edit-config   ( --- )         \ edit your own F-PC.CFG (in USER-DIR)
                make-user-dir
                cfghndl count user-file ucfghndl $>handle
                ucfghndl hopen
                if      copy-config             \ first time: start from
                else    ucfghndl hclose drop    \ the installed one
                then
                ucfghndl $file ?open.error
                cr ." Editing " ucfghndl count type
                ."  (used at the next start)" 1 seconds
                1 edit ;


