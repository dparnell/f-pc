\ IBMCURSR      IBM Specific display       Enhancements by Tom Zimmer   F-PC native port

DECIMAL

\ The INT 10h calls are emulated by the VM: the cursor and the screen are
\ the virtual text screen (VIDEO-BUF), see VIDEO.SEQ.

: IBM-AT        ( col row -- )          \ set cursor position
                AT-XY ;

\ CODE IBM-SCR@ and IBM-SCR! (INT 10h AH=8 / AH=9) were commented out in
\ the original; BIOS-VIDEO would do them.

: IBM-AT?       ( -- col row )          \ read cursor position
                GET-XY ;

: LFILLW        ( addr byte-count word -- )     \ fill with 16 bit words
\ F-PC native port: was ( seg start-addr byte-count word -- ); flat address.
                -ROT 2/ 0
                ?DO     2DUP W!  2+
                LOOP    2DROP ;

: IBM-DARK      ( -- )                  \ Clear the screen
\ The original reset the video mode (INT 10h AH=0), which clears the screen
\ to attribute 7 and homes the cursor.
                VIDEO-BUF ROWS COLS 2* * $0720 LFILLW
                0 0 AT-XY ;

\ : rev-dark      ( --- )
\                 ?dosio
\                 if      ibm-dark
\                 else    blank.color
\                         VIDEO-BUF ROWS COLS 2* *
\                         attrib c@ $10 /mod swap $10 * or flip $20 or LFILLW
\                         show.color
\                 then    0 0 at ;

: norm-dark     ( --- )
                ?dosio
                if      ibm-dark
                else    blank.color
                        VIDEO-BUF ROWS COLS 2* *
                        attrib c@ flip $20 or LFILLW
                        show.color
                then    0 0 at ;

: IBM--LINE     ( -- )                  \ delete the line the cursor is on
                $0601                           \ scroll up one line
                $0700                           \ filler attribute 7
                GET-XY NIP FLIP                 \ from the cursor row, column 0
                ROWS 1- FLIP COLS 1- +          \ to the bottom right corner
                BIOS-VIDEO 2DROP 2DROP ;

: >IBM          ( -- )
                ['] IBM-AT    IS AT
                ['] IBM-AT?   IS AT?
                ['] NORM-DARK IS DARK
                ['] IBM--LINE IS -LINE ;        >IBM

: CURSOR_POS_INIT       ( --- )
                IBM-AT? #LINE ! #OUT ! ;

' CURSOR_POS_INIT IS CURSORSET

CURSOR_POS_INIT

\ Cursor shape control words by Tom Zimmer

\ SET-CURSOR and GET-CURSOR are VM built-ins (KERNEL4.SEQ).
\ CODE SET-CURSOR ( N1 --- )
\                 POP CX
\                 MOV AH, # 1
\                 PUSH SI         PUSH BP
\                 INT $10
\                 POP BP          POP SI
\                 NEXT C;
\
\ : GET-CURSOR    ( --- SHAPE ) 0 $460 @L ;

: CURSOR-OFF    ( --- ) GET-CURSOR $2000  OR SET-CURSOR ;

: CURSOR-ON     ( --- ) GET-CURSOR $0F0F AND SET-CURSOR ;

ONLY FORTH ALSO HIDDEN DEFINITIONS ALSO

: *NORM-CURSOR  ( --- )
                CROWS DUP 1- FLIP + SET-CURSOR ;

: *BIG-CURSOR   ( --- )
                CROWS SET-CURSOR ;

: *MED-CURSOR   ( --- )
                CROWS DUP 2/ FLIP + SET-CURSOR ;

FORTH DEFINITIONS

DEFER NORM-CURSOR       ' *NORM-CURSOR IS NORM-CURSOR
DEFER BIG-CURSOR        ' *BIG-CURSOR IS BIG-CURSOR
DEFER MED-CURSOR        ' *MED-CURSOR IS MED-CURSOR

DEFINED SRCON NIP
#IF
        SRCON           \ now default to source on for debugging
#THEN

ONLY FORTH ALSO DEFINITIONS

