\\ NEXPECT.SEQ   A version of EXPECT that allows line editing  F-PC native port

        From XEXPECT by Tom Zimmer, modified by Mike Mayo and
        subsequently again modified by Tom Zimmer.

        This utility allows you to use the line editors control
        key sequences to edit the Forth command line.  If you make an
        error while typing, you can select and recover a previously
        entered line by pressing UP or DOWN ARROW.  Complete the entry
        with the Enter key, or cancel with the ESC key.

        You can also recover previously entered Forth command lines up
        to 12, by pressing Up or Down arrow to step through the displayed
        command line list.

        This utility adds about 1.5k to the system.

        F-PC native port: the command line history XBSEG is a POINTER,
        which now returns an address, so >XBUF returns the address of
        the current history line (it was an offset in the segment) and
        the CMOVELs became CMOVEs. The shift keys are read with
        SHIFT-STATE. A terminal resize (key K-RESIZE) while the history
        box is up closes the box (it was laid out for the old size);
        the edit line itself is redrawn by LEDIT.

{

           only forth  also
\+ editor       editor also             \ if editor present, include it
                hidden also definitions

\ if ?SHIFTKEY is not defined and available from the editor, then
\ define it here
\- ?shiftkey    : ?shiftkey ( -- f1 ) shift-state $03 and 0<> ;

headerless

 12 constant xmax       \ number of command lines to stack.
133 constant cmdlen     \ length of one command line.
  0    value save-get1? \ first time we press down arrow this is 0.

cmdlen xmax 1+ * s>d pointer xbseg      \ extended expect buffer segment

create xtmp cmdlen allot

0 value xbuf#

: xbinit        ( --- )
                xbseg 0=
                if      cr ." Couldn't allocate command line save buffer."
                        abort
                then
                xbseg cmdlen xmax 1+ * erase ;

xbinit          \ Allocate some space so we can use line edit now.

: xbuf_init     ( --- )
                defers initstuff
                xbinit ;

' xbuf_init is initstuff

: xbuf#-        ( --- )
                xbuf# 1- 0<
                if      xmax =: xbuf#
                else    decr> xbuf#
                then    ;

: xbuf#+        ( --- )
                xbuf# 1+ xmax u>
                if      off> xbuf#
                else    incr> xbuf#
                then    ;

: >xbuf         ( --- a1 )      \ address of the current history line
                xbuf# xmax min 0MAX cmdlen * xbseg + ;

0 value nshown  \ flag to say that the lines are already shown on the screen

: ?save-editbuf ( -- )
        editbuf c@ 2 >
        if  editbuf >xbuf editbuf c@ 1+ cmove  then
        ;

2variable nxysave
0 value ninsert

: nquit         ( -- )
                restscr
                nxysave 2@ !> ey drop 0 !> ex   \ place editor on new line
                off> nshown
                ninsert dup !> insertmode
                if      big-cursor
                else    norm-cursor
                then
                ['] >norm   !> >edattrib
                ['] defmenu !> equit ;

: .nexpect-box  ( -- )
                insertmode @ !> ninsert
                at? nxysave 2! savescr
                0 rows xmax 1+ rows 3 - min - 3 -
                cols 1-  rows 2- box&fill
        3 rows 2- at ." \r Select/edit a command line "
        ." \1 Press \3\1 \3\1 to select,  \3sh-\1 \3sh-\1 to move \0"
                insertmode on big-cursor
                ['] >attrib3 !> >edattrib
                ['] nquit    !> equit ;

\ new save-get
: nsave-get ( -- )
        xmax 1+ rows 3 - min >r
        tx 1+ ty 1+ dup =: bline at
        r@ 0 do xbseg i cmdlen * + count type cols 2- sp>col
                bcr                     \ show command lines buffer
             loop
        rows r> - 2- xbuf# +    \ row we are editing
        =: ey  1 =: ex          \ place editor on new line
        >xbuf editbuf over c@ 1+ cmove
        off> ecursor
        ;

: xup ( -- )
    nshown if
        ?save-editbuf
        ?shiftkey if
                        >xbuf editbuf over c@ 1+ cmove
                        >xbuf
                        xbuf#-
                        >xbuf swap over c@ 1+ cmove
                        editbuf >xbuf editbuf c@ 1+ cmove
                  else
                        xbuf#-
                  then
   else editbuf c@
        if      editbuf >xbuf editbuf c@ 1+ cmove
        then
        xbuf#-
        .nexpect-box
   then
        on> nshown
        nsave-get ;

: xdown ( -- )
    nshown if
        ?save-editbuf
        ?shiftkey if
                        >xbuf editbuf over c@ 1+ cmove
                        >xbuf
                        xbuf#+
                        >xbuf swap over c@ 1+ cmove
                        editbuf >xbuf editbuf c@ 1+ cmove
                  else
                        xbuf#+
                  then
   else .nexpect-box
   then
        on> nshown
        nsave-get ;

\ F-PC native port: K-RESIZE handler for the LEDIT key table while
\ NEW-EXPECT runs. The history box was drawn for the old screen size,
\ so take it down; the next Up/Down arrow draws it again.
0 value xresize-prev            \ the table entry we replaced

: xresize       ( -- )
                nshown if nquit then
                xresize-prev execute ;

: new-expect       ( a1 n1 --- )
                xbseg printing @ 0= and         \ use old expect if printing
        if      savescr
                savecursor
                ['] xup     save!> doup
                ['] xdown   save!> dodown
                ['] defmenu save!> equit
                ['] >norm   save!> >edattrib
                            save>  keysfuncptr
                >keys1
                K-RESIZE lkey@ save!> xresize-prev
                ['] xresize K-RESIZE lkey!
                xbuf#+
                xtmp off
                off> stripping_bl's     \ disable removal of trailing bl's
                off> autoclear          \ disable auto entry clearing
                swap >r >r              \ save destination address under
                off> ecursor
                insertmode off
                off> nshown
                #out @ #line @ xtmp r> <ledit>

                r>                      \ recover destination address

                swap  xtmp c@ 2 >  and  \ only store longer lines
                if      xtmp >xbuf xtmp c@ 1+ cmove
                else    xbuf#-          \ only advance if we got something
                then    ( a1 --- )      \ a1 is the address passed to EXPECT.
                xtmp count >r swap r@ cmove   \ move the line to TIB
                R> span !
                xresize-prev K-RESIZE lkey!     \ put the key table back
                restore> xresize-prev
                restore> keysfuncptr
                restore> >edattrib
                restore> equit
                restore> dodown
                restore> doup
                restcursor
                restscr
                xtmp count type space   \ show the actual command line
        else    (expect)
        then    ;

' new-expect is expect

only forth also definitions

headers

