\ EDITSTUF.SEQ  Stuff needed by the editor              by Tom Zimmer
\                                                       F-PC native port

\ F-PC native port: the editor's far memory is one heap block (BASESEG,
\ a POINTER) cut into the handle stack, the line pointer table, the line
\ delete buffer, the write buffer and the text buffer. The values that
\ held segments (HSEG LSEG DSEG WSEG TSEGB TOFF TEND) now hold byte
\ addresses, and #EDSEGS MAXSEGS are sizes in bytes. See SEDCODE.SEQ for
\ the text buffer and line pointer table layout.

headers

only forth also definitions
vocabulary editor
editor definitions also hidden also

headerless

0.0 pointer baseseg     \ bottom of allocated editor space (an address)

0 value tsegb           \ text buffer address for current file
0 value lseg            \ line pointer table address
0 value dseg            \ delete lines buffer address
0 value #edsegs         \ size of the text buffer in bytes
0 value maxsegs         \ total bytes allocated in BASESEG
0 value hseg            \ hyper or help handle stack address
0 value toff            \ first free byte after the lines above CURLINE
0 value tend            \ address of the current line (start of the lines
                        \ from CURLINE to the end, kept at the buffer top)
0 value linesave        \ a place to save the screen line
0 value screenline      \ current screen line
0 value lastline        \ last valid line in file.
0 value rmmax           \ right margin max for current doc
0 value rmset?          \ are we setting the right margin?
0 value ?browse         \ are we currently in browse mode?
0 value winoff          \ window horizontal scrolling offset
0 value read-from       \ start reading file at READ-FROM line
0 value newfl           \ was new file created?
0 value edready         \ ready to edit, we have a file, and can enter
                        \ editor on it, with no problem.
0 value seding          \ are we in the SED editor
0 value backing-out     \ flag true if we are poping out of an edit
0 value splitwind?

0 value backingup
0 value renaming        \ are we keeping backup files?
 TRUE =: renaming
0 value scrline         \ target screen edit line

handle ed1hndl          \ the file we are editing
handle ed2hndl          \ a work handle

2variable currentsize   \ size of the current file on disk in
                        \ 128 byte sectors.

: .ed1hndl      ( --- )
                ed1hndl count type ;

\ For the largest window possible, set these values to those values shown
\ to the right in the comments.

\ F-PC native port: the window follows the screen size, ROWS and COLS (see
\ SEDLAYOUT in SEDITOR.SEQ). SEDROWS SEDCOLS hold the screen size the
\ window was last laid out for.

    1      value first.textline         \  1
 rows 2-   value last.textline          \ rows-2
    1      value first.textcol          \  0
 cols 2-   value last.textcol           \ cols
 rows      value sedrows
 cols      value sedcols

: seginit       ( --- )
                defers initstuff
                0.0 currentsize 2!
                off> tsegb off> hseg
                off> lseg  off> dseg
                rows 2- =: last.textline
                cols 2- =: last.textcol
                rows =: sedrows
                cols =: sedcols ;

' seginit is initstuff

 2000      constant writelim    \ write buffer full limit
  132      constant mxlln       \ maximum line length
    0      value maxlines       \ maximum number of edit file lines
                                \ dynamically adjusted to memory
\ F-PC native port: the text buffer size, in bytes. MAXLINES is derived
\ from it in TBUF.INIT. Change it before the first edit (or after
\ UNPOINTER> BASESEG OFF> TSEGB) to edit bigger files.
$100000    value edbufsize      \ 1 Mbyte of text
  100      value maxdline       \ number of saved deleted lines
                                \ adjusted down to 20 if low on memory

   20      constant maxh        \ maximum edit nest depth
b/hcb 4 cells +  constant b/hstk \ bytes per hyper stack entry: an HCB
                                \ then LOADLINE SCREENCHAR ?BROWSE LINESAVE

\   0      value screenchar     \ ********** moved to SEQREAD.SEQ ******
    0      value curline
    0      value wseg           \ the write buffer address
    0      value wblen          \ write buffer length
                                \ n1 = edit file line number

: memabort      ( n1 --- )
                8 = abort" Could not allocate memory for Editor" ;

: tbuf.init     ( --- )         \ Allocate the edit buffers.
        tsegb 0=
        if      unpointer> baseseg      \ release old allocation
\+ inbseg       inbseg drop             \ make sure lineread space allocated

\ F-PC native port: there is no DOS MAXBLOCK to size the buffers from. The
\ text buffer is EDBUFSIZE bytes, and a line takes at least one cell, but
\ real lines are much longer: allow one line per 16 bytes of text. Every
\ part is cell aligned. The handle stack has one spare entry for HROTATE,
\ the line table 4 spare cells and the delete buffer one spare line.

                edbufsize aligned =: #edsegs
                #edsegs 16 / =: maxlines
                100 =: maxdline
                maxh 1+ b/hstk *        aligned
                maxlines 4 + cells              +
                maxdline 1+ mxlln *     aligned +
                writelim 256 +          aligned +
                #edsegs                         +
                dup =: maxsegs
                0 sizeof!> baseseg              \ maximum edit buffer size
                baseseg dup 0= if 8 memabort then
                dup =: hseg     maxh 1+ b/hstk *        aligned +
                dup =: lseg     maxlines 4 + cells              + \ ptr table
                dup =: dseg     maxdline 1+ mxlln *     aligned + \ delete buf
                dup =: wseg     writelim 256 +          aligned + \ write buf
                    =: tsegb                                      \ text buffer
        then    ;

0 value hdepth
0 value browselevel

: ed1>hstack    ( --- )         \ move the current edit handle to the
                                \ handle save stack
                hseg 0= ?exit
                hdepth maxh <
                if      ed1hndl   hseg b/hstk hdepth * +   b/hcb   cmove
                        hseg hdepth b/hstk * + b/hcb + >r
                        loadline @ r@           !
                        screenchar r@ cell+     !
                        ?browse    r@ 2 cells + !
                        linesave   r> 3 cells + !
                        incr> hdepth
                        incr> browselevel
                then    ;

: hstack>ed1    ( --- )         \ move the top handle from the handle
                                \ save stack back to the edit handle
                hseg 0= ?exit
                decr> browselevel
                hdepth 1- 0MAX =: hdepth
                hseg b/hstk hdepth * +   ed1hndl   b/hcb   cmove
                hseg hdepth b/hstk * + b/hcb +
                      dup @    loadline !
                cell+ dup @ =: screenchar
                cell+ dup @ =: ?browse
                cell+     @ =: scrline ;

\ F-PC native port: HSWAP below is left in its original (segment) form.
\ : hswap         ( --- )         \ Swap top two handle stack entries.
\               hdepth 2 < ?exit
\               hseg b/hstk hdepth 1- * hseg b/hstk hdepth    * b/hstk cmovel
\               hseg b/hstk hdepth 2- * hseg b/hstk hdepth 1- * b/hstk cmovel
\               hseg b/hstk hdepth    * hseg b/hstk hdepth 2- * b/hstk cmovel
\               ;

: hrotate       ( --- )         \ rotate the handle stack.
                hseg 0= ?exit
                hseg            hseg b/hstk hdepth * +  b/hstk cmove
                hseg b/hstk +   hseg    b/hstk hdepth *         cmove ;

: ?hstack       ( --- f1 )      \ return true if room on hstack
                hdepth maxh < ;

defer edinit            ' tbuf.init is edinit   \ Allocate the editor space

: edcr          ( --- )         \ CR for the editor subscreen scroll.
                last.textline rows 4 - >
                splitwind? or
                if      ['] crlf is cr          \ unlink this word from CR
                        crlf                    \ do a real CR
                else    0 last.textline 2+ at
                        -line 0 rows 1- at
                then    ;

: edscroll-on   ( --- )
                ['] edcr is cr ;

defer edscroll          ' edscroll-on is edscroll       \ setup scrolling

forth definitions

headers

: done          ( --- )
                ['] crlf is cr ;

: nobackup      ( --- )
                off> backingup ;

' nobackup alias backupoff

: backupon      ( --- )
                on> backingup ;

headerless

backupon        \ default to auto backup of data

: shomem        ( -- )          \ display the computers memory map
                savecursor savescr
                dark cursor-off
                0 4 at .mem
                cr cr ."    \3 Press any key to continue "
                key drop
                restscr restcursor ;

forth definitions

