\ KERNEL1.SEQ  Kernel primitives, part 1.        F-PC native port

\ Originally the 8086 CODE words of F-PC's kernel (Tom Zimmer, Bob Smith,
\ after F83 by Henry Laxen and Michael Perry). In the native port every
\ primitive is a C built-in of the VM (vm/prims.def); BUILTIN asserts that the
\ VM provides it, so this file still lists the kernel's word set in its
\ original order. See docs/kernel-design.md.
\
\ Gone with the 8086 layer: ORIGIN, DPUSH, APUSH, >NEXT, ABNORM, BIOSBK,
\ DOSBK, NESTPATCH, DOESPATCH, the metacompiler's T: words, GO, PDOS, and
\ the paragraph words U16/ UD16/ PARAGRAPH DPARAGRAPH (flat memory).

DECIMAL

\ ---- inner interpreter and code-field handlers ----------------------------
\ NEST DODOES DOCONSTANT DOVALUE DOUSER-VARIABLE DODEFER DOUSER-DEFER are
\ code tokens, not words; see CT-NEST etc.

BUILTIN EXIT            ( -- )          \ Terminate a high-level definition
BUILTIN ?EXIT           ( f1 -- )       \ If f1 is true, exit from definition
BUILTIN UNNEST          ( -- )          \ Same as EXIT; compiled by ;

BUILTIN (LIT)           ( -- n )        \ Fetch an in-line cell
BUILTIN <'>             ( -- n )        \ Same as (LIT), marks a ['] for DECOM

\ ---- control-flow runtime --------------------------------------------------
\ The no-op and branch words are distinct so the decompiler can tell the
\ control structures apart.

BUILTIN DOBEGIN         ( -- )          \ really a NOOP
BUILTIN DOCASE          ( -- )          \ really a NOOP
BUILTIN DOENDCASE       ( -- )          \ really a NOOP
BUILTIN DOTHEN          ( -- )          \ really a NOOP
BUILTIN DOAGAIN         ( -- )          \ an unconditional branch
BUILTIN DOREPEAT        ( -- )          \ an unconditional branch
BUILTIN ?WHILE          ( f -- )        \ branch if flag is zero
BUILTIN ?UNTIL          ( f -- )        \ branch if flag is zero
BUILTIN BRANCH          ( -- )          \ Unconditional branch
BUILTIN DOENDOF         ( -- )          \ Unconditional branch
BUILTIN ?BRANCH         ( f -- )        \ Branch if flag is zero
BUILTIN NEXT|           ( -- )          \ Primitive form of NEXT (FOR - NEXT)

BUILTIN UNDO            ( -- )          \ Clean up return stack to EXIT a DO loop
BUILTIN (LOOP)          ( -- )          \ Primitive form of LOOP
BUILTIN (+LOOP)         ( n -- )        \ Primitive form of +LOOP
BUILTIN (DO)            ( l i -- )      \ Primitive form of DO
BUILTIN (?DO)           ( l i -- )      \ Primitive form of ?DO
BUILTIN (OF)            ( n1 n2 -- n1 | n1 n1 -- )  \ Primitive form of OF
BUILTIN BOUNDS          ( n1 n2 -- n1+n2 n1 )   \ Limits for a DO loop

BUILTIN EXECUTE         ( cfa -- )      \ Execute the word whose CFA is on stack
BUILTIN PERFORM         ( addr-of-cfa -- )      \ @ EXECUTE
BUILTIN GOTO            ( -- )          \ EXIT and execute the in-line word
BUILTIN EXEC:           ( n1 -- )       \ execute the n-th word following EXEC:
BUILTIN NOOP            ( -- )          \ Does nothing

DEFER PAUSE             ' NOOP IS PAUSE \ Used by the multi-tasker

BUILTIN I               ( -- n )        \ index of the innermost loop
BUILTIN J               ( -- n )        \ index of the second loop
BUILTIN K               ( -- n )        \ index of the third loop
BUILTIN (LEAVE)         ( -- )          \ jump past the end of a DO-LOOP
BUILTIN (?LEAVE)        ( f -- )        \ if f is non-zero, LEAVE

\ ---- memory -----------------------------------------------------------------

BUILTIN @               ( addr -- n )   \ Fetch a cell
BUILTIN !               ( n addr -- )   \ Store a cell
BUILTIN C@              ( addr -- char )
BUILTIN C!              ( char addr -- )
BUILTIN W@              ( addr -- n )   \ 16 bits, zero extended (new)
BUILTIN W!              ( n addr -- )   \ 16 bits (new)

\ The original CMOVE moved words when it could, so it could not be used as a
\ FILL. The port's CMOVE is a plain ascending byte move (kernel-design.md 1).
BUILTIN CMOVE           ( from to count -- )
BUILTIN CMOVE>          ( from to count -- )    \ highest address first
BUILTIN PLACE           ( from cnt to -- )      \ make a counted string
BUILTIN +PLACE          ( from cnt to -- )      \ append to a counted string

DECIMAL

\ ---- stacks -------------------------------------------------------------------

BUILTIN SP@             ( -- addr )     \ address of the top stack item
BUILTIN SP!             ( addr -- )
BUILTIN RP@             ( -- addr )
BUILTIN RP!             ( addr -- )
BUILTIN DROP            ( n1 -- )
BUILTIN DUP             ( n1 -- n1 n1 )
BUILTIN SWAP            ( n1 n2 -- n2 n1 )
BUILTIN OVER            ( n1 n2 -- n1 n2 n1 )
BUILTIN PLUCK           ( n1 n2 n3 -- n1 n2 n3 n1 )
BUILTIN TUCK            ( n1 n2 -- n2 n1 n2 )
BUILTIN NIP             ( n1 n2 -- n2 )
BUILTIN ROT             ( n1 n2 n3 -- n2 n3 n1 )
BUILTIN -ROT            ( n1 n2 n3 -- n3 n1 n2 )
BUILTIN FLIP            ( n1 -- n2 )    \ swap the two low bytes (16-bit value)
BUILTIN SPLIT           ( n1 -- lo hi ) \ the two low bytes of n1
BUILTIN JOIN            ( lo hi -- n )  \ two bytes into a 16-bit value
BUILTIN ?DUP            ( n1 -- [n1] n1 )
BUILTIN ?DROP           ( n false -- false | n true -- n true )
BUILTIN R>              ( -- n )
BUILTIN R>DROP          ( -- )
BUILTIN DUP>R           ( n1 -- n1 )
BUILTIN >R              ( n -- )
BUILTIN 2R>             ( -- n1 n2 )
BUILTIN 2>R             ( n1 n2 -- )
BUILTIN R@              ( -- n )
BUILTIN 2R@             ( -- n1 n2 )
BUILTIN PICK            ( nm .. n1 k -- nm .. n1 nk )
BUILTIN RPICK           ( k -- nk )     \ k-th item of the return stack

\ ---- logic and arithmetic ---------------------------------------------------------

BUILTIN AND             ( n1 n2 -- n3 )
BUILTIN OR              ( n1 n2 -- n3 )
BUILTIN XOR             ( n1 n2 -- n3 )
BUILTIN NOT             ( n -- n' )     \ bitwise invert
BUILTIN TRUE            ( -- -1 )
BUILTIN FALSE           ( -- 0 )
BUILTIN CSET            ( b addr -- )   \ OR b into the byte at addr
BUILTIN CRESET          ( b addr -- )   \ clear the b bits of the byte at addr
BUILTIN CTOGGLE         ( b addr -- )   \ toggle the b bits of the byte at addr
BUILTIN ON              ( addr -- )     \ store TRUE
BUILTIN OFF             ( addr -- )     \ store FALSE
: -1!           ( addr -- )     ON ;
: 0!            ( addr -- )     OFF ;
BUILTIN INCR            ( addr -- )
BUILTIN DECR            ( addr -- )
BUILTIN 0DECR           ( addr -- )     \ decrement, but not below zero
BUILTIN +               ( n1 n2 -- sum )
BUILTIN NEGATE          ( n -- n' )
BUILTIN -               ( n1 n2 -- n1-n2 )
BUILTIN ABS             ( n1 -- n2 )
BUILTIN D+!             ( d addr -- )
BUILTIN +!              ( n addr -- )
BUILTIN C+!             ( n addr -- )

\ There are no I/O ports in the native port: PC@ and P@ read $FF, PC! and
\ P! do nothing.
BUILTIN PC@             ( port# -- n )
BUILTIN P@              ( port# -- n )
BUILTIN PC!             ( n port# -- )
BUILTIN P!              ( n port# -- )

BUILTIN #THREADS        ( -- n )        \ threads per vocabulary

BUILTIN 2*              ( n -- 2*n )
BUILTIN 2/              ( n -- n/2 )    \ arithmetic shift
BUILTIN U2/             ( u -- u/2 )    \ logical shift
: U8/           ( u -- u/8 )    3 RSHIFT ;
: 8*            ( n -- 8*n )    3 LSHIFT ;
BUILTIN 1+              ( n1 -- n2 )
BUILTIN 2+              ( n1 -- n2 )
BUILTIN 1-              ( n1 -- n2 )
BUILTIN 2-              ( n1 -- n2 )
BUILTIN CELL            ( -- 4 )        \ new: bytes per cell
BUILTIN CELL+           ( a -- a+cell ) \ new
BUILTIN CELL-           ( a -- a-cell ) \ new
BUILTIN CELLS           ( n -- n*cell ) \ new
BUILTIN UM*             ( u1 u2 -- ud )
BUILTIN *               ( n1 n2 -- n3 )
: U*D           ( n1 n2 -- d )  UM* ;
BUILTIN UM/MOD          ( ud un -- urem uquot )  \ overflow gives -1 -1

BUILTIN 0=              ( n -- f )
BUILTIN 0<              ( n -- f )
BUILTIN 0>              ( n -- f )
BUILTIN 0<>             ( n -- f )
BUILTIN =               ( n1 n2 -- f )
BUILTIN <>              ( n1 n2 -- f )
: ?NEGATE       ( n1 n2 -- n3 )  \  If n2 is negative, negate n1.
                0< IF    NEGATE   THEN   ;
BUILTIN U<              ( u1 u2 -- f )
BUILTIN U>              ( u1 u2 -- f )
BUILTIN <               ( n1 n2 -- f )
BUILTIN >               ( n1 n2 -- f )
BUILTIN UMIN            ( u1 u2 -- u3 )
BUILTIN MIN             ( n1 n2 -- n3 )
BUILTIN MAX             ( n1 n2 -- n3 )
BUILTIN 0MAX            ( n1 -- n2 )
BUILTIN UMAX            ( u1 u2 -- u3 )
BUILTIN WITHIN          ( n lo hi -- f )        \ lo <= n < hi
BUILTIN BETWEEN         ( n lo hi -- f )        \ lo <= n <= hi, signed
BUILTIN UBETWEEN        ( u lo hi -- f )        \ lo <= u <= hi, unsigned

\ ---- double numbers: high cell on top of the stack and at the lower address --

BUILTIN 2@              ( addr -- d )
BUILTIN 2!              ( d addr -- )
BUILTIN 2DROP           ( d -- )
BUILTIN 3DROP           ( n1 n2 n3 -- )
BUILTIN 2DUP            ( d -- d d )
BUILTIN 3DUP            ( n1 n2 n3 -- n1 n2 n3 n1 n2 n3 )
BUILTIN 2SWAP           ( d1 d2 -- d2 d1 )
BUILTIN 2OVER           ( d1 d2 -- d1 d2 d1 )
BUILTIN D+              ( d1 d2 -- dsum )
BUILTIN DNEGATE         ( d -- -d )
BUILTIN S>D             ( n -- d )
BUILTIN DABS            ( d1 -- d2 )
BUILTIN D2*             ( d -- d*2 )
BUILTIN D2/             ( d -- d/2 )
BUILTIN D-              ( d1 d2 -- d3 )
: ?DNEGATE      ( d1 n -- d2 )  \ If n is negative, negate d1.
                0< IF   DNEGATE   THEN   ;
BUILTIN D0=             ( d -- f )
BUILTIN D=              ( d1 d2 -- f )
BUILTIN DU<             ( ud1 ud2 -- f )
BUILTIN D<              ( d1 d2 -- f )
: D>            ( d1 d2 -- f )  2SWAP D<   ;
: 4DUP          ( a b c d -- a b c d a b c d )  2OVER 2OVER   ;
BUILTIN DMIN            ( d1 d2 -- d3 )
BUILTIN DMAX            ( d1 d2 -- d3 )
BUILTIN *D              ( n1 n2 -- d )  \ signed product

: M/MOD         ( d# n1 -- rem quot )
\ Divide a signed double by a signed single, leaving a floored remainder and
\ quotient.
                FM/MOD ;
BUILTIN MU/MOD          ( ud un -- urem udquot )
BUILTIN /               ( num den -- quot )     \ Floored and signed division.
BUILTIN /MOD            ( num den -- rem quot )
BUILTIN MOD             ( n1 n2 -- rem )
BUILTIN */MOD           ( n1 n2 n3 -- rem quot )  \ double intermediate
BUILTIN */              ( n1 n2 n3 -- n1*n2/n3 )
BUILTIN ROLL            ( n1 n2 .. nk k -- n2 n3 .. nk n1 )
: 2ROT          ( a b c d e f - c d e f a b )   5 ROLL  5 ROLL  ;
