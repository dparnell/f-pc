\ EXEC.SEQ      A utility for calling DOS from Forth.   by Tom Zimmer   F-PC native port

only forth also hidden also definitions

: initcmdpath   ( --- )         \ Initialize the Command path
                defers initstuff
                comspec@ comspec$ count 70 min cmdpath place
                0 cmdpath count + c! ;

' initcmdpath is initstuff      \ Put into initialization chain.

\ F-PC native port: the original wrote F-PC out to EMS or disk, restored
\ the interrupt vectors and EXECed COMMAND.COM /C with the command line.
\ Natively <EXTEXEC> (EMMEXEC.SEQ) runs EXEC$ through the host shell
\ (SYSTEM); an empty EXEC$ starts an interactive shell. F-PC stays in
\ memory, so there is nothing to swap out or restore.

: $sys          ( countedstring --- f1 ) \ spawn a shell
                exec$      $100 erase
                count $FE min exec$ place       \ the command line
                <extexec>                       \ actually do the system call
                cursor_pos_init                 \ restore cursor position
\u blinkoff     blinkoff                        \ disable background blink
                ;

: ?syserror     ( n1 --- )      \ handle ONLY the "can't run" codes
\ F-PC native port: the result is the shell's exit status. 127 and 126 are
\ the shell's "not found" / "can't execute"; other codes are the command's.
                dup  127 = abort" Command not found"
                dup  126 = abort" Can't execute command"
                drop ;

defer clearmem  ' noop is clearmem

: nd$sys        ( countedstring -- f1 )         \ shell with no disksave
                $sys ;

forth definitions

: "swapfile     ( a1 n1 -- )            \ set the disk swapfile for $SYS
                dup 0=
                if      2drop
                        " FPCIMAGE.$$$"                 \ set to default name
                then    2drop                           \ F-PC native port:
                diskon ;                \ nothing is swapped out (no EXTHNDL)

: swapfile      ( | name -- )
                bl word count "swapfile ;

comment:

The SYS word relys on a string compiled in the handle CMDPATH, to
contain the name and path to COMMAND.COM. For SYS to work, this string
must specify the actual location of COMMAND.COM on your hard disk,
or floppy. The drive may be omitted, which will cause SYS to look on
the current drive.

F-PC native port: SYS passes the line to the host shell (/bin/sh -c);
CMDPATH is only informational.

comment;

: sys           ( command --- )
                clearmem
                0  word cr $sys ?syserror ;

' SYS ALIAS `   ( command --- )

: ``            ( command --- )
                clearmem
                0  word cr nd$sys ?syserror ;

hidden definitions

create cmdbuf 256 allot                 \ F-PC native port: was
                                        \ RP0 @ 100 -, which is inside
                                        \ the return stack now.

: "syscommand   ( a1 n1 c1 --- )        \ pass string a1,n1 to dos with line
                                        \ following appended to it.
                clearmem
                >r ">$ cmdbuf over c@ 1+ cmove
                r> word count
                2dup bounds ?do i c@ '\' = if '/' i c! then loop
                                        \ DOS path separators for the host
                dup>r cmdbuf count + swap cmove
                r> cmdbuf c@ + cmdbuf c!
                cmdbuf count + off
                cmdbuf nd$sys ?syserror ;

: dir.name      ( --- )
                16 save!> tabsize
                #OUT @ COLS 16 - > IF CR THEN
                #out @ >r pad 30 + 12 bounds
                do      i c@ ?dup
                        if emit else leave then
                loop    10 #out @ r> - - spaces
                pad 21 + c@ 16 and
                if      ." <DIR>"
                then    tab restore> tabsize ;

: $dir          ( a1 --- )
                here over c@ 1+ cmove
                here pathset drop
                ."  For directory " here count type
                here count + off here 1+
                CR  PAD SET-DTA $33 find-first  \ $33=files & directories
                BEGIN   255 and 0=
                WHILE   dir.name find-next REPEAT  ;

forth definitions

\ F-PC native port: the DOS commands are mapped to the host. DIR lists with
\ FIND-FIRST/FIND-NEXT (DOS wildcards, names matched without regard to
\ case, 8.3 names only); CHDIR changes F-PC's own directory (a shell's cd
\ would not); DEL COPY REN run rm cp mv through the shell, with \ turned
\ into / in the arguments.

: dir           ( <filespec> --- )      \ directory of <filespec>.
                bl word dup c@ 0=
                if      drop " *.*" ">$
                then    $dir cr ;

: del           ( <filespec> --- )      \ delete files
                " rm " bl "syscommand ;

\ ' del alias delete

: chdir         ( <filespec> --- )      \ change directory
                bl word dup c@ 0=
                if      drop pad 0 pdos drop    \ no argument: show it
                        cr ." \" pad 64 2dup 0 scan nip - type
                        exit
                then    count pad place 0 pad count + c!
                0 pad 1+ $3B00 hdos1 nip        \ DOS chdir (function 3B)
                abort" Can't change to that directory"
                seqhandle >hndle @ 0<
                IF      seqhandle dup clr-hcb pathset drop
                        -2 seqhandle >hndle !
                THEN    ;

' chdir alias cd        \ Watch OUT, this is also a HEX number.

: copy          ( <filespec> --- )      \ copy files
                " cp " 0 "syscommand ;

: ren           ( <filespec> --- )      \ rename files
                " mv " 0 "syscommand ;

' ren  alias rename
' dark alias cls

comment:

: "setdrive     ( a1 n1 --- )           \ set drive a as default drive.
                clearmem
                ">$ nd$sys ?syserror
                seqhandle >hndle @ -2 =
                if      -1 seqhandle >hndle !
                then    ;

: a:            ( --- )                 \ set drive b as default drive.
                " a:" "setdrive ;

: b:            ( --- )                 \ set drive b as default drive.
                " b:" "setdrive ;

: c:            ( --- )                 \ set drive c as default drive.
                " c:" "setdrive ;

comment;

                \ Here are some additional system commands you can
                  \ add if you need them. Just un-comment: them out.
comment:

: rd            ( <filespec> --- )      \ remove directory
                " rd " bl "syscommand ;

' rd alias rmdir

: md            ( <filespec> --- )      \ make directory
                " md " bl "syscommand ;

' md alias mkdir

: format        ( <drivespec> --- )     \ format disk
                " format " bl "syscommand ;

: ftype         ( <filespec> --- )      \ type a file
                " type " bl "syscommand ;

: path          ( <pathspec> --- )      \ gt or set search path
                " path " bl "syscommand ;

: cls           ( --- )
                " cls " bl "syscommand ;

comment;

only forth also definitions


