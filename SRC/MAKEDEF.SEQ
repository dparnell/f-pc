\ MAKEDEF.SEQ   Make a : (colon) definition into a DEFERed word   F-PC native port

\ **********************************************************************
\ Converts "name", a normal ':' definition into a defered word, and
\ creates a new word "name2" as a ':' definition with the old function
\ of "name". "name2" is also installed into the defered word "name".
\
\       Used in the form:  MAKEDEFER <existing:def> <new:def> Return
\
\ **********************************************************************

: :def?         ( a1 -- )       \ verify that a1=cfa is a colon definition
                @ CT-NEST <>            \ -- f1
                abort" MUST be a colon definition!" ;

\ F-PC native port: the original patched CALL/JMP machine code into the
\ code fields. Now a colon definition is the CT-NEST token plus one body
\ cell (its token list) and a DEFER is CT-DODEFER plus one cell (the xt),
\ so the conversion just swaps tokens and body cells.

: makedefer     ( | name name2 -- )     \ make name into a defered word
                                        \ make name2 the function that used
                                        \ to be name
                ' dup :def?             \ -- a1
                defer last @ name>      \ -- a1 a2     name2, for now a DEFER
                CT-NEST over !CT        \ make name2 a colon definition
                over >body @ over >body !       \ with the body of name
                CT-DODEFER rot tuck !CT \ -- a2 a1     make name a DEFER
                >body ! ;               \ that executes name2

\ **********************************************************************
\ Switch the bodies of the two ':' definitions following SWITCH
\ **********************************************************************

: xchange       ( a1 a2 -- )    \ exchange the contents of a1 & a2
                dup @ >r over @ swap ! r> swap ! ;

: switch_bodies ( a1 a2 -- )    \ switch bodies of two colon definitions
                                \ a1 & a2 are code field addresses
                dup :def? >body swap
                dup :def? >body xchange ;

: switch        ( | name name2 -- )
                ' ' switch_bodies ;

