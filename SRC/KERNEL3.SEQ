\ KERNEL3.SEQ   More kernel stuff: dictionary, interpreter and compiler
\                                                       F-PC native port

\ Header layout (HEAD region; see vm/seed.c):
\   VFA cell (LOADLINE) | LFA cell (previous LFA in thread) |
\   NFA: count|$80 [|$40 immediate], name, last char|$80 | CFA cell
\ A colon definition's code field is CT-NEST and its body is one cell: the
\ address of its token list in LIST space. In-line strings in token lists
\ are counted and padded to a cell boundary.

: >TYPE         ( adr len -- )
                TUCK PAD SWAP CMOVE   PAD SWAP TYPE  ;

: .(            ( -- )  ASCII ) PARSE >TYPE  ; IMMEDIATE
: (             ( -- )  ASCII ) PARSE 2DROP  ; IMMEDIATE

: TRAVERSE      ( addr direction -- addr' )
\ Step by direction from addr until a byte with its high bit set.
                SWAP BEGIN OVER + DUP C@ 128 AND UNTIL NIP ;

: DONE?         ( n -- f )
\ True if STATE differs from n, or the input stream is exhausted.
                STATE @ <>   END? @ OR   END? OFF   ;

: N>LINK        ( anf -- alf )  CELL-   ;
: L>NAME        ( alf -- anf )  CELL+   ;
: BODY>         ( apf -- acf )  CELL-   ;
: NAME>         ( anf -- acf )  1 TRAVERSE   1+ @  ;
: LINK>         ( alf -- acf )  L>NAME   NAME>   ;
: >BODY         ( acf -- apf )  CELL+   ;

: NO-NAME       ( -- )  ;

BUILTIN (>NAME)         ( cfa -- nfa | 0 )      \ search every vocabulary
: >NAME         ( cfa -- nfa )
                (>NAME) ?DUP 0= IF ['] NO-NAME (>NAME) THEN ;
: >LINK         ( acf -- alf )  >NAME   N>LINK   ;
: >VIEW         ( acf -- avf )  >LINK   CELL-   ;
: VIEW>         ( avf -- acf )  CELL+   LINK>   ;

COMMENT:
  The hash algorithm used is as follows:
        ((firstchar*2)+secondchar)*2)+count
  This seems to provide a good distribution across the 64 threads in
1000 word FORTH vocabulary.
COMMENT;

BUILTIN HASH            ( str-addr voc-ptr -- thread )
BUILTIN (FIND)          ( here alf -- cfa flag | here false )

: PRIOR.CHECK   ( n1 -- n1 f1 )         \ true if n1 was the prior vocabulary
                DUP PRIOR @ OVER PRIOR ! = ;

: %%FIND        ( addr false #vocs 0 -- cfa flag | addr false )
                DO      DROP CONTEXT I CELLS + @ DUP
                        IF      PRIOR.CHECK
                                IF      DROP FALSE
                                ELSE    OVER SWAP HASH @ (FIND)
                                        DUP ?LEAVE
                                THEN
                        THEN
                LOOP    ;

: %FIND         ( addr -- cfa flag | addr false )
\ An empty word sets END? and finds an immediate NOOP.
                DUP C@
                IF      PRIOR OFF  FALSE #VOCS 0 %%FIND
                ELSE    DROP END? ON  ['] NOOP 1
                THEN    ;

DEFER FIND      ' %FIND IS FIND

: DEFINED       ( -- here 0 | cfa [ -1 | 1 ] )
\ Parse a word and find it; a 'c' character literal is not upper cased.
                BL WORD
                DUP C@ 3 = OVER 1+ C@ ASCII ' = AND OVER 3 + C@ ASCII ' = AND
                0= IF ?UPPERCASE THEN  FIND   ;

: STACKUNDER    ( -- )
                TRUE ABORT" Stack Underflow" ;

: STACKOVER     ( -- )
                TRUE ABORT" Stack Overflow" ;

: WARNOVER      ( -- )
                CR ."  Running out of CODE memory! " ;

BUILTIN SP-LIMIT        ( -- addr )     \ lowest address of the data stack

: (?STACK)      ( -- )
                SP@ SP0 @ U>      IF  STACKUNDER  THEN
                SP@ SP-LIMIT U<   IF  STACKOVER   THEN
                HERE 280 + LIMIT U>  IF  WARNOVER  THEN ;

DEFER ?STACK    ' (?STACK) IS ?STACK

: INTERP        ( -- )
                BEGIN   ?STACK DEFINED
                        IF     EXECUTE
                        ELSE   NUMBER  DOUBLE? NOT IF  DROP  THEN
                        THEN   FALSE DONE?
                UNTIL   ;

DEFER STATUS    ( -- )
DEFER INTERPRET ' INTERP IS INTERPRET

: PRINT         ( -- ) PRINTING ON INTERPRET PRINTING OFF ;

BUILTIN ALLOT           ( n -- )
BUILTIN ,               ( n -- )
BUILTIN C,              ( n -- )
BUILTIN ALIGN           ( -- )          \ align HERE to a cell (no longer a no-op)
: EVEN          ( n1 -- n2 )    ; IMMEDIATE

BUILTIN COMPILE         ( -- )          \ compile the in-line word

: IMMEDIATE     ( -- )
                64 ( Precedence bit ) LAST @ CSET  ;

: LITERAL       ( n -- )
                COMPILE (LIT) X, ; IMMEDIATE

: DLITERAL      ( d# -- )
                SWAP [COMPILE] LITERAL [COMPILE] LITERAL ; IMMEDIATE

: ASCII         ( -- n )
                BL WORD   1+ C@
                STATE @ IF   [COMPILE] LITERAL   THEN   ; IMMEDIATE

: CONTROL       ( -- n )
                BL WORD   1+ C@  31 AND
                STATE @ IF   [COMPILE] LITERAL   THEN   ; IMMEDIATE

: CRASH         ( -- )
\ The default action of a DEFER: name the DEFER that called us.
                R@ CELL- @ >NAME CR .ID TRUE
                ABORT" <- is an Uninitialized execution vector."  ;

: %?MISSING     ( f -- )
                IF      SPACE HERE COUNT TYPE
                        TRUE ABORT"  <- What? "
                THEN    ;
' %?MISSING IS ?MISSING

: '             ( -- cfa )
                DEFINED 0= ?MISSING   ;

: [']           ( -- )
                ' COMPILE <'> X, ; IMMEDIATE

: [COMPILE]     ( -- )
                ' X,   ; IMMEDIATE

VARIABLE  "BUF 132 ALLOT

: XALIGN        ( -- )          XHERE ALIGNED XDP ! ;

: (")           ( -- addr len )
\ Return the in-line counted string that follows and skip it.
                R> COUNT 2DUP + ALIGNED >R ;
: (X")          ( -- addr len )
                R> COUNT 2DUP + ALIGNED >R ;
: %(.")         ( -- )
                R> COUNT 2DUP + ALIGNED >R TYPE ;
DEFER (.")      ' %(.") IS (.")

: ,"            ( -- )
                ASCII " PARSE TUCK HERE PLACE 1+ ALLOT ;

: X,"           ( -- )          \ compile a counted string in list space
                ASCII " PARSE 255 MIN DUP XC,
                BOUNDS ?DO I C@ XC, LOOP XALIGN ;

: ."            ( -- )          COMPILE (.") X,"   ;   IMMEDIATE
: "             ( -- )          COMPILE (")  X,"   ;   IMMEDIATE
: ""            ( -- )          COMPILE (X") X,"   ;   IMMEDIATE

: ">$           ( a1 n1 -- a2 )
                DROP 1- ;

BUILTIN FENCE           \ head-space address below which FORGET may not go

: TRIM          ( faddr voc-addr -- )
\ Unlink every header at or above faddr from the vocabulary's threads.
                #THREADS 0
                DO      2DUP @ BEGIN   2DUP U> NOT WHILE @ REPEAT
                        NIP OVER ! CELL+
                LOOP    2DROP   ;

: (FRGET)       ( code-addr view-addr -- )
                DUP FENCE @ U< ABORT" Below fence"  ( ca va )
                OVER VOC-LINK @ BEGIN   2DUP U< WHILE   @ REPEAT
                DUP VOC-LINK !  ( ca va ca pt ) NIP
                BEGIN   DUP WHILE   2DUP #THREADS CELLS - TRIM   @   REPEAT
                DROP    YDP !
                DUP @ CT-NEST =                 \ If it's a : def
                IF      DUP >BODY @ XDP !       \ Set back XHERE too!
                THEN    DP !  ;

DEFER ?ERROR

: (ABORT")      ( f -- )
\ If f is true, report the in-line message through ?ERROR.
                R> COUNT 2DUP + ALIGNED >R  ROT ( a n f )
                DUP IF  ?ERROR  ELSE  3DROP  THEN ;

: ABORT"        ( -- )
                COMPILE (ABORT") X," ;   IMMEDIATE

: ABORT         ( -- )
                TRUE ABORT" "  ;

: FORGET        ( -- )
                BL WORD ?UPPERCASE DUP CURRENT @ HASH @
                (FIND) 0= ?MISSING DUP >VIEW (FRGET) ;

: ?CONDITION    ( f -- )
                NOT ABORT" Conditionals Wrong"   ;

: >MARK         ( -- addr )     XHERE 0 X,   ;
: >RESOLVE      ( addr -- )     XHERE SWAP !   ;
: <MARK         ( -- addr )     XHERE ;
: <RESOLVE      ( addr -- )     X, ;
: ?>MARK        ( -- f addr )   TRUE >MARK   ;
: ?>RESOLVE     ( f addr -- )   SWAP ?CONDITION >RESOLVE  ;
: ?<MARK        ( -- f addr )   TRUE   <MARK   ;
: ?<RESOLVE     ( f addr -- )   SWAP ?CONDITION <RESOLVE  ;

comment:
        LEAVE and ?LEAVE could be non-immediate in this system, but the 83
        standard specifies an immediate LEAVE, so they  both are for
        uniformity.
comment;

: LEAVE         ( -- )
                COMPILE (LEAVE)  ; IMMEDIATE

: ?LEAVE        ( f1 -- )
                COMPILE (?LEAVE) ; IMMEDIATE

comment:
        BEGIN, THEN, DO ?DO, LOOP, +LOOP, UNTIL, AGAIN, REPEAT, IF ELSE,
        WHILE: These are the compiling words needed to properly compile the
        Forth Conditional Structures. Each of them is immediate and they
        must compile their runtime routines along withwhatever addresses
        they need. A modest amount of errorchecking is done. If you want to
        rip out the error checking change the ?> and ?< words to > and <
        words, and all of the 2DUPs to DUPs and the 2SWAPs to SWAPs. The
        rest should stay the same.

        DOAGAIN, DOTHEN, DOBEGIN, ?UNTIL & ?WHILE are words that are NOOPs
        , or equivalant to ?BRANCH. They are provided to make it easier for
        the Decompiler to know where the control structures start and end.
comment;

: BEGIN         ( -- )
                COMPILE DOBEGIN ?<MARK                          ; IMMEDIATE

: AGAIN         ( -- )
                COMPILE DOAGAIN ?<RESOLVE                       ; IMMEDIATE

: UNTIL         ( n -- )
                COMPILE ?UNTIL  ?<RESOLVE                       ; IMMEDIATE

: WHILE         ( n -- )
                COMPILE ?WHILE ?>MARK 2SWAP ( <- added )        ; IMMEDIATE

: REPEAT        ( -- )       ( 2SWAP removed )
                COMPILE DOREPEAT ?<RESOLVE ?>RESOLVE            ; IMMEDIATE

: DO            ( lim start -- )
                COMPILE (DO)   ?>MARK                           ; IMMEDIATE

: ?DO           ( lim start -- )
                COMPILE (?DO)  ?>MARK                           ; IMMEDIATE

: LOOP          ( -- )
                COMPILE (LOOP)  2DUP CELL+ ?<RESOLVE ?>RESOLVE  ; IMMEDIATE

: +LOOP         ( n -- )
                COMPILE (+LOOP) 2DUP CELL+ ?<RESOLVE ?>RESOLVE  ; IMMEDIATE

: IF            ( n -- )
                COMPILE  ?BRANCH  ?>MARK                        ; IMMEDIATE

: ELSE          ( -- )
                COMPILE  BRANCH ?>MARK  2SWAP ?>RESOLVE         ; IMMEDIATE

: THEN          ( -- )
                COMPILE DOTHEN ?>RESOLVE                        ; IMMEDIATE

: FORWARD       ( -- )
                COMPILE BRANCH ?>MARK                           ; IMMEDIATE

: CONTINUE      ( -- )
                2OVER [COMPILE] REPEAT                          ; IMMEDIATE

: BREAK         ( -- )
                COMPILE EXIT [COMPILE] THEN                     ; IMMEDIATE

: AFT           ( -- )
                2DROP [COMPILE] FORWARD ?<MARK 2SWAP            ; IMMEDIATE

: FOR           ( n1 -- )
                COMPILE >R ?<MARK                               ; IMMEDIATE

: NEXT          ( -- )
                COMPILE NEXT| ?<RESOLVE                         ; IMMEDIATE

: ,VIEW         ( -- )
                LOADLINE @ Y, ;

: NOHEADROOM    ( -- )
                TRUE ABORT" Out of HEAD memory!" ;

: NOLISTROOM    ( -- )
                TRUE ABORT" Out of LIST memory!" ;

BUILTIN HEAD-LIMIT      ( -- addr )     \ end of the HEAD region
BUILTIN LIST-LIMIT      ( -- addr )     \ end of the LIST region

: SPCHECK       ( -- )                  \ HEAD AND LIST SPACE CHECK
                YHERE 96 + HEAD-LIMIT U>  IF  NOHEADROOM  THEN
                XHERE 96 + LIST-LIMIT U>  IF  NOLISTROOM  THEN ;

: %ALREADY_DEF  ( a1 -- a1 )   \ Is the word at A1 already defined?
                WARNING @
                IF      DUP FIND NIP
                        IF      DUP  CR  COUNT TYPE ."  isn't unique "
                        THEN
                THEN    ;       ( str )

DEFER ?ALREADY_DEF      ' %ALREADY_DEF IS ?ALREADY_DEF

: <"HEADER>     ( str-addr -- )
                SPCHECK
                DUP C@ 31 > ABORT" Name TOO LONG, > 31 chars!"
                ?ALREADY_DEF
                ALIGN  ,VIEW
                YHERE OVER CURRENT @ HASH DUP @  Y,  ( link  ) ! ( current )
                YHERE LAST ! ( remember nfa )
                YHERE SWAP  DUP C@  WIDTH @  MIN 1+ >R  ( yh str )
                YHERE R@ CMOVE ( copy str ) R> YDP +!
                128 SWAP CSET   128 YHERE 1- CSET   ( delimiter Bits )
                HERE Y, ( CFA in header )
                ;

DEFER "HEADER   ' <"HEADER> IS "HEADER

: <HEADER>      ( | name -- )
                BL WORD ?UPPERCASE "HEADER ;

DEFER HEADER    ' <HEADER> IS HEADER

: "CREATE       ( str-addr -- )
                "HEADER CT-DOVAR , ;

: CREATE        ( | name -- )
                HEADER CT-DOVAR , ;

: !CSP          ( -- )
                SP@ CSP !   ;

: ?CSP          ( -- )
                SP@ CSP @ <> ABORT" Stack Changed"   ;

: HIDE          ( -- )
                LAST @ DUP N>LINK @ SWAP CURRENT @ YHASH ! ;

: REVEAL        ( -- )
                LAST @ DUP N>LINK    SWAP CURRENT @ YHASH ! ;

BUILTIN NEW-DOES        ( list-addr -- ct ) \ a code token for a DOES> clause
BUILTIN (DOES>)         ( -- )          \ set LAST's code token, then EXIT

: DOES>         ( -- )
\ The rest of the definition is the DOES> clause; it gets its own code
\ token, compiled in-line after (DOES>).
                COMPILE (DOES>) XHERE 0 X,  XHERE NEW-DOES SWAP ! ; IMMEDIATE

VOCABULARY ASSEMBLER
DEFER SETASSEM  \ Setup for assembly stuff to follow
' NOOP IS SETASSEM

: [             ( -- )
                STATE OFF   ;   IMMEDIATE

\ ;USES and ;CODE attach native code to a defining word; they return with
\ the abstract-machine assembler (kernel-design.md 5).

: (])           ( -- )
                STATE ON
                BEGIN   ?STACK  DEFINED DUP
                        IF      0>
                                IF      EXECUTE   ELSE   X,   THEN
                        ELSE    DROP    NUMBER  DOUBLE?
                                IF           [COMPILE] DLITERAL
                                ELSE    DROP [COMPILE] LITERAL
                                THEN
                        THEN    TRUE    DONE?
                UNTIL   ;

DEFER ]         ' (]) IS ]

: MAKEDUMMY     ( name -- )
                HEADER CT-NEST ,
                XALIGN XHERE ,
                COMPILE UNNEST ;

: ANEW          ( name -- )
                >IN @ >R DEFINED NIP  R@ >IN !
                IF      FORGET
                THEN    R> >IN !  MAKEDUMMY   ;
                                                        \ Add if needed
: (:)           ( -- )
                !CSP   CURRENT @ CONTEXT !
                HEADER CT-NEST ,
                XALIGN XHERE ,
                HIDE ;

: :             ( -- )
                (:) ] ;

: ;             ( -- )
                STATE @ 0= ABORT" Not Compiling!"
                ?CSP   COMPILE UNNEST   REVEAL   [COMPILE] [  ; IMMEDIATE

: RECURSIVE     ( -- )
                REVEAL ;   IMMEDIATE

: CONSTANT      ( n -- )
                HEADER CT-DOCONST , ,  ;

: VALUE         ( n -- )
                HEADER CT-DOVALUE , ,  ;

: VARIABLE      ( -- )
                CREATE 0 ,  ;

: ARRAY         ( n1 -- )
                CREATE ALLOT  ;

: DEFER         ( -- )
                HEADER CT-DODEFER , ['] CRASH ,  ;

: VOCABULARY    ( -- )
                CREATE   #THREADS 0 DO   0 ,  LOOP
                HERE  VOC-LINK @ ,  VOC-LINK !
                DOES> CONTEXT !  ;

: DEFINITIONS   ( -- )
                CONTEXT @ CURRENT !   ;

: 2CONSTANT     ( d1 | <name> -- )
                CREATE   , ,    ( d# -- )
                DOES> 2@   ;    ( -- d# )

: 2VARIABLE     ( | <name> -- )
                0 0 2CONSTANT   ( -- )
                DOES> ;         ( -- addr )

: <RUN>         ( -- )
        STATE @ IF      ]
                        STATE @ NOT
                        IF   INTERPRET   THEN
                ELSE    INTERPRET   THEN   ;

DEFER RUN       ' <RUN> IS RUN

DEFER ERRFIX    ' NOOP IS ERRFIX

DEFER QUIT                              \ resolved in KERNEL4

: (?ERROR)      ( adr len f -- )
                IF      ['] <RUN> IS RUN ERRFIX
                        2>R SP0 @ SP!   PRINTING OFF
                        2R> SPACE TYPE SPACE   QUIT
                ELSE    2DROP  THEN  ;

' (?ERROR) IS ?ERROR
