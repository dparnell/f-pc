\ SAVESCR.SEQ   Routine to save and restore screen.     by Tom Zimmer   F-PC native port

decimal

\ F-PC native port: the original kept up to SVMAX screen images of a fixed
\ size (ROWS*COLS*2) in one paragraph buffer, SVSEG. The screen size can
\ change at any time now (terminal resize), so each saved screen is its own
\ ALLOCATEd block that records the size it was saved at:
\       +0 columns   +4 rows   +8 the (char,attr) cells, row stride cols*2
\ SVSTACK holds the saved screens, most recent first. Restoring copies the
\ area common to the saved and the current screen.

16 constant svlimit             \ most screens SVSTACK can hold
    4 value svmax               \ maximum number of screens to save
 4000 value svsize              \ size of the screen at the last save
create svstack svlimit cells allot      \ the saved screens
       svstack svlimit cells erase

: svinit        ( --- )         \ screen save initialization
                defers initstuff
                rows cols 2* * =: svsize        \ set save size per screen
                svmax svlimit min =: svmax
                svstack svlimit cells erase ;   \ nothing saved yet

' svinit is initstuff

: svline        ( a1 n1 --- )   \ copy line n1 of saved screen a1 to the
                                \ screen, if both have that line
                dup 0< if 2drop exit then
                over cell+ @ over > 0= if 2drop exit then
                dup rows < 0= if 2drop exit then
                >r
                dup 2 cells + over @ 2* r@ * +          \ source line
                video-buf cols 2* r> * +                \ destination line
                rot @ cols min 2* cmove ;

: svshow        ( a1 --- )      \ show saved screen a1
                blank.color
                rows 0 ?do dup i svline loop drop
                show.color ;

\ nestable save and restore up to SVMAX times.

: savescr       ( --- )
                rows cols 2* * dup =: svsize
                2 cells + allocate if drop exit then    \ no memory
                cols over ! rows over cell+ !
                blank.color
                video-buf over 2 cells + svsize cmove   \ & save screen in it.
                show.color
                svstack svmax 1- cells + @ ?dup         \ oldest falls off
                if      free drop
                then
                svstack dup cell+ svmax 1- cells cmove> \ Make a hole
                svstack ! ;

: restscr       ( --- )
                svstack @ ?dup 0= ?exit
                dup svshow free drop                    \ Restore screen &
                svstack cell+ svstack svlimit 1- cells cmove \ compress
                0 svstack svlimit 1- cells + ! ;

: recoverscr    ( --- )                                 \ get a copy of the
                svstack @ ?dup                          \ last saved screen
                if      svshow
                then    ;

: recoverline   ( n1 --- )                          \ get a copy of line n1
                svstack @ ?dup                      \ from last saved screen
                if      swap svline
                else    drop
                then    ;

comment:

\ This commented out section of code saves and restores the screen on entry
\ and exit from F-PC. It is not being compiled at the present time because
\ I do not like the effect.

2variable entry-curpos

0 rows 1- entry-curpos 2!               \ initialize to bottom of screen

: entry-save    ( --- )                 \ save screen on entering F-PC
                defers initstuff
                #out @ #line @ entry-curpos 2!
                savescr ;

' entry-save is initstuff

: exit-restore  ( --- )                 \ and restore screen on leaving F-PC
                defers byefunc
                restscr
                entry-curpos 2@ at ;

' exit-restore is byefunc

comment;

\ Do we need screen blanking for out COLOR display, here are the words to
\ select blanking or non-blanking.

: blankon       ( --- )
                blanking on ;

: blankoff      ( --- )
                blanking off ;

