\ NEW-WFL.SEQ   A NEW window file selection tool from RUSSIA
\ F-PC native port

\ F-PC native port: the CODE words are high level Forth on the emulated DOS
\ calls (HDOS1, BDOS, PDOS, FIND-FIRST/NEXT and the kernel's flat DTA@/DTA!),
\ and the window is laid out from COLS and ROWS instead of 80x25: there are
\ ROWS-6 names per column and as many 17 wide columns as fit (at least 3);
\ the help panel stays on the right. A K-RESIZE key re-lays the window out.
\ The pop-up dialogs keep their 80x25 positions (they need 76x17).

\ This appears to be a significant improvement in my file selection
\ utility.  Though it is quite large (12k), it works very well.
\ I (Tom Zimmer) have made only very minor changes to make it
\ compatible with the current version of F-PC.  The strange characters
\ in the comments, translate to cyrilic characters on a russian
\ computer.


\ Оконный селектор файлов.

decimal         \ F-PC native port: no PREFIX assembler

        variable curr-color     \  color setting mode
\ F-PC native port: was INT 10h AH=09h, write char n l times at the cursor
\ with ATTRIB, leaving the cursor where it was. Now stored straight into
\ VIDEO-BUF at #OUT #LINE (where AT put the cursor), clipped to the screen.
: draw-line     ( l,n -- )
                #line @ rows < 0= if 2drop exit then
                swap cols #out @ - 0max min             ( n l' )
                #line @ cols * #out @ + 2* video-buf +  ( n l' a )
                swap 0 ?do  2dup c!  attrib @ over 1+ c!  2+  loop
                2drop ;

 vocabulary getvoc

 also hidden also getvoc getvoc definitions

\ string in format ASCIIZ *.* for searching files in catalog

create MASK*.*  ascii * c, ascii . c, ascii * c, 0 c,

        defer get-attrib1       ' noop is get-attrib1
        defer get-attrib2       ' noop is get-attrib2
        defer get-attrib4       ' noop is get-attrib4
        defer get-attrib5       ' noop is get-attrib5
        defer get-attrib6       ' noop is get-attrib6
        defer get-attrib10      ' noop is get-attrib10

\ Coordinates for typing file names on the screen

create X-COORD  3 C, 20 C, 37 C,

  3             constant Y-COORD
  56            constant PATH-LONG      \ length of path buffer
                                        \ F-PC native port: was 38; host
                                        \ paths are longer

  24            constant NAME-LONG      \ length of name buffer

  14            constant MASK-LONG      \ length of searching mask

2000            constant MAXFILES       \ length of segment names buffer
                                        \ F-PC native port: was 500

 256            constant PBUF-LONG      \ F-PC native port: size of the path
                                        \ buffers, they were 70 bytes


\ Format of coding the file in the buffer: length - 4 bytes,
\ length of file name - 1-13 bytes. That makes up to 17 bytes as a maximum.

        variable attribs
           4 cells allot        \ saving color attributes (5 cells)

        variable old-path
        PBUF-LONG allot         \ saving path to current catalog

        variable curr-time
                 8 allot        \ String of time counter  uses for reducing
                                \ "trash" on the screen.
maxfiles 16 um*
        pointer  dir-seg        \ Pointer of the segment to be used.

        variable end-files      \ Pointer of a space occupied by files.
                                \ Grous up.

        variable end-catalogs   \ Pointer of a space occupied by catalogs.
                                \ Grous down.

        variable n-files        \ Files counter.

        variable n-catalogs     \ Catalogs counter.

        variable ?end-select    \ "True" means that file was chosen

        variable path-buf
        PBUF-LONG allot         \ Buffer for inputing and editing of path
                                \ Length of the buffer is determined by DOS
                                \ requiremens.

        variable ren-buf
        PBUF-LONG allot         \ Buffer for inputing and editting of file
                                \ names

        variable mask-buf
            MASK-LONG allot
                                \ Mask buffer  for choosing files

        variable name-buf
            NAME-LONG allot     \ Buffer for inputing and editing file name

        variable u-dta
                 $80 allot
                                \ Buffer for DTA while searching files

        variable end-seg
                                \ End of names buffer

        variable ?newpage       \ "true" - means that it is necessary
                                \ to rewrite the screen

        variable curr-name      \ Number of chosen file

        variable ~offset        \ offset

        variable find-buf
                 20 allot       \ Letters buffer  for searching

        variable old-litera     \

        variable curr-device    \ Current drive number


        variable first-file?    \ Are any files in catalog ?


        variable x&y.mouse      \ Hold on current mouse coordinates


 MAXFILES 1- 16 * end-seg !

\ F-PC native port: the window geometry, set from COLS and ROWS by
\ NWFL-GEOMETRY (it was fixed: 3 columns of 19 names, 57 to a page, the
\ help panel at column 52 and the right edge at 78).

   3 value #fcols               \ columns of names
  19 value #frows               \ names in a column
  57 value #fpage               \ names on a page
  52 value panel-x              \ x of the line left of the help panel
  78 value right-x              \ x of the right edge of the window
   0 value wfl-cols             \ the COLS and ROWS laid out for
   0 value wfl-rows

: nwfl-geometry ( -- )
                cols 29 - 17 / 3 max =: #fcols
                rows 6 - 4 max =: #frows
                #fcols #frows * =: #fpage
                #fcols 17 * 1+ =: panel-x
                panel-x 26 + =: right-x
                cols =: wfl-cols  rows =: wfl-rows ;

: ?resized      ( -- f )        \ has the terminal changed size since?
                cols wfl-cols <>  rows wfl-rows <> or ;

: list-bottom   ( -- y )  #frows 2+ ;   \ last line of names (was 21)
: sep-y         ( -- y )  #frows 3 + ;  \ line under the names (was 22)
: stat-y        ( -- y )  #frows 4 + ;  \ status line (was 23)
: bot-y         ( -- y )  #frows 5 + ;  \ bottom edge (was 24)

: ?4+          ( n, t/f -- n/n+4 )
                if 4 + then ;

: scr-up        ( -- )     \ INT 10h AH=06: scroll the names up a line
                $0601 attrib @ $FF and 256 * $0304
                list-bottom 256 * panel-x 2- or
                bios-video 2drop 2drop ;

: scr-down      ( -- )     \ INT 10h AH=07: scroll the names down
                $0701 attrib @ $FF and 256 * $0304
                list-bottom 256 * panel-x 2- or
                bios-video 2drop 2drop ;

\ To read in buffer " path-buf " path to current catalog

: curr-path     ( -- )                  \ INT 21h AH=47h
                path-buf 3 + 0 pdos drop ;

\ Changing catalog according with string in the buffer

: set-path      ( ASCIIZ -- t/f )       \ INT 21h AH=3Bh
                0 swap $3B00 hdos1              \ 0, or the DOS error code
                if exit then drop 0 ;

\ change device number 0 - A, 1 - B ...

: change-drv    ( n -- )                \ INT 21h AH=0Eh
                $0F and $0E bdos drop ;

\ Convert count string to  ASCIIZ string

: count>z       ( a -- )
                dup c@ ?dup
                if      >r dup 1+ over r@ cmove \ move the string down
                        r> + 0 swap c!          \ add 0 to the string end
                else    drop                    \ if 0, stop
                then    ;


: z>count       ( a -- )
                dup >r
                begin   dup c@                  \ find the 0 at the end
                while   1+
                repeat  r@ -                    ( n )
                r@ dup 1+ 2 pick cmove>         \ move the string up
                r> c! ;                         \ counter init

\ prepeare string with counter in memory for screen output by TYPE,

\ F-PC native port: the 8086 version built the string in place; this one
\ builds it in N>TBUF and copies it back. The result is a counted string of
\ 14 characters: a blank, the name padded to 8, a blank, the extension
\ padded to 3, and a blank; "." and ".." come out as " ." and " ..".

create n>tbuf 16 allot

: n>type        ( a -- )
                dup c@ 0= if drop exit then     \ if 0, stop
                n>tbuf 15 blank  14 n>tbuf c!
                dup >r c@ ascii . =
                if      r@ 1+ c@ ascii . = 1 and 1+     \ "." or ".."
                        n>tbuf 2+ swap ascii . fill
                else    r@ dup 64 0 scan drop over -    ( a len )
                        2dup ascii . scan               ( a len e n' )
                        2swap drop                      ( e n' a )
                        2 pick over -                   ( e n' a namelen )
                        n>tbuf 2+ swap 8 min cmove      ( e n' )
                        1 /string 0max n>tbuf 11 + swap 3 min cmove
                then    n>tbuf r> 15 cmove ;

: first-find    ( adr,attr -- t/f )     \ true if nothing was found
                find-first 0<> ;

: next-find     ( -- t/f )      \ on an error, an error code under true
                find-next 0<> dup if 18 swap then ;

\ F-PC native port: DTA@ ( -- d ) and DTA! ( d -- ) are gone; the kernel's
\ DTA@ ( -- addr ) and DTA! ( addr -- ) take flat addresses.


: curr-drv      ( - n )                 \ INT 21h AH=19h
                0 $19 bdos $FF and ascii A + ;


: sys-del       ( a,t/f -- t,/f )       \ true on an error
                if $4100 else $3A00 then        \ delete file / catalog
                >r 0 swap r> hdos1 nip 0<> ;

\ file renaming
\ steck top   : a1 - address ASCIIZ chain old name  ,
\               a2 - address ASCIIZ chain new name .

: sys-ren       ( a1,a2 -- t/f )        \ INT 21h AH=56h
                \ F-PC native port: <HRENAME> takes two handles and renames
                \ the names at handle+1, so pass the ASCIIZ addresses less 1
                >r 1- r> 1- <hrename> nip 0<> ;

\ сбросить атрибуты файла

: drop-atr      ( a -- t,/f )           \ INT 21h AX=4301h, CX=0
                \ F-PC native port: the VM can't set attributes; it reports
                \ success, and a host file can be deleted anyway
                0 swap $4301 hdos1 nip 0<> ;

\ преобразовать номер файла (каталога) в координаты X и Y для печати на экран

: n>at          ( n -- x,y )
                #frows /mod                     \ F-PC native port: was 19
                17 * 3 +                        \ X-COORD, for any column
                swap Y-COORD + ;

\ Переслать атрибуты файла, его длинну и ASCIIZ имя в буфер

\ F-PC native port: entries are at DIR-SEG plus an offset (END-FILES), and
\ ROOM? stops the list overwriting itself (the original didn't check).

: room?         ( -- f )
                end-files @ 17 + end-catalogs @ 13 - < ;

: +file         ( -- )
                room? 0= ?exit
                u-dta 26 + @  dir-seg end-files @ + !   \ the file length
                dir-seg end-files @ + 4 +  u-dta 30 +   ( dst src )
                begin   dup c@ dup ascii A ascii Z between
                        if      32 +                    \ lower case
                        then    dup 3 pick c!
                        >r 1+ swap 1+ swap r> 0=
                until   drop dir-seg - end-files !
                1 n-files +! ;

\ прочитать имя файла из буфера файлов в буфер пользователя

: @file         ( a,n -- )
                dir-seg swap 0                  \ skip n entries
                ?do     4 +  begin count 0= until
                loop    swap                    ( src a )
                over 4 + 64 0 scan drop 1+ 2 pick - cmove ;

\ Переслать ASCIIZ имя каталога в буфер изменив порядок литер на обратный

: +catalog      ( -- )                  \ stored backwards, going down
                room? 0= ?exit
                u-dta 30 + w@ $002E = ?exit     \ skip "."
                1 n-catalogs +!
                u-dta 30 +  dir-seg end-catalogs @ +    ( src dst )
                begin   over c@ dup 2 pick c!
                        >r 1- swap 1+ swap r> 0=
                until   nip dir-seg - end-catalogs ! ;

: @catalog      ( a,n -- )
                dir-seg end-seg @ + swap 0      \ skip n names going down
                ?do     begin   dup c@ swap 1- swap 0=
                        until
                loop                            ( a src )
                begin   dup c@ dup 3 pick c!
                        >r 1- swap 1+ swap r> 0=
                until   2drop ;

\ получить длинну файла из DTA или буфера с аналогичным форматом записи длинны
\ на стек - число двойной длинны

: @long         ( a -- d )
                @ 0 ;

\ получить имя файла или каталога в буфер true - имя файла, 0 - каталога.

: @name         ( a,n -- t/f )
                ~offset @ + n-catalogs @ 2dup <
                if drop @catalog 0 else - @file true then ;

: z-type        ( ASCIIZ -- )
                dup n>type count type ;

: messeg-window ( --)
                17 10 do 5 i at 70 spaces loop ;

: please.wait   ( -- )
                >rev
                16 10 do  3 i at 48 spaces loop
                8 11 at 36 ascii ─ draw-line ." ┌" 44 11 at ." ┐"
                8 12 at ." │         Reading directory.        │"
                8 13 at ." │         Please wait.              │"
                8 14 at 36 ascii ─ draw-line ." └" 44 14 at ." ┘"
                >norm ;

: scoops-dir    ( -- )
                savescr please.wait
                n-catalogs 0! n-files 0! end-files 0!
                end-seg @ end-catalogs !
                dta@ u-dta dta!                 \ пользовательский DTA
                mask*.* $37 first-find          \ получить имя первого файла
                dup first-file? !
                if 0 else                       \ F-PC native port: no DTA
                begin                           \ to look at if none found
                [ u-dta 21 + ] literal c@       \ считать атрибут и пересылать
                $10 and if +catalog then        \ в буфер, если каталог
                next-find until
                then drop
                mask-buf $23 first-find 0=      \ получить имя первого файла
                if
                  begin +file next-find
                  until drop
                then
                dta! restscr ;                  \ восстановить DTA

\ собрать имя текущего файла, путь к файлу и имя устройства в буфере имени

: scoops-name   ( a -- )
                path-buf count >r ren-buf 1+ r@ cmove
                path-buf c@ 3 <>
                 if ascii \ ren-buf r@ + 1+ c!
                 else r> 1- >r
                 then
                name-buf + dup z>count                  \ смещение со стека
                count ren-buf r@ + 2+ swap dup>r cmove
                r> r> + 1+ ren-buf c!
                true ren-buf dup c@ + ren-buf
                do i c@ ascii . = if drop 0 leave then loop
                if ascii . ren-buf count + c! ren-buf incr then ;

: .time-key     ( -- )
                begin   key?  mousebutton or ?resized or dup 0=
                        if      refresh 10 ms   \ F-PC native port: show the
                        then                    \ screen, don't spin; a
                until   >norm ;                 \ resize is seen by KEY-SELECT

: wait-esc      ( -- )
                7 emit 20 15 at 6 spaces ." Press Esc to continue ... "
                6 spaces >norm
                begin   .time-key key
                        27 =
                until   >norm ;

: .da           ( -- )
                ."   Yes  " ;

: .net          ( -- )
                ."   No   " ;

: mouse-y/n     ( -- 27/13/0 )
                mousebutton 2 = if 27 exit then
                show.ms mousexy hide.ms 15 =
                if
                  dup 22 28 ubetween if drop 13 exit then    \ код ENTER
                  dup 50 56 ubetween if drop 27 exit then    \ код ESC
                then
                drop false ;

: ?yes/no       ( x1,y1,x2,y2,t/f -- t/f )
                >r
                begin
                 2dup at r@ if >norm else >rev  then .net 2swap
                 2dup at r@ if >rev  else >norm then .da  2swap
                 >norm show.ms .time-key hide.ms
                 mousebutton
                 if mouse-y/n else key then
                 dup 27 = if r> 2drop 2drop 2drop 0 exit then 13 <>
                while
                 r> -1 xor >r
                repeat 2drop 2drop r> ;

: type-tail     ( a n max -- )  \ F-PC native port: type the last max
                2dup > if >r + r@ - r> else drop then type ;

: .at-path      ( -- )
                get-attrib10 17 1 at right-x 18 - spaces
                17 1 at  nosetcur 0!
                \ F-PC native port: show the end of a path too long to fit
                path-buf count pad place
                path-buf c@ 3 <> if " \" pad +place then
                mask-buf dup z>count dup count pad +place count>z
                pad count right-x 18 - type-tail
                true nosetcur ! >norm ;
: at-name       ( a -- )        \ со стека смещение для scoops-name
                >norm 8 13 at 64 spaces 10 13 at scoops-name
                ren-buf count 62 type-tail ;    \ F-PC native port: clip

: qweshn-file   ( -- )
                19 11 at  ." ─── Do you wish to delete this file? ───"
                4 at-name ;

: qweshn-cat    ( -- )
                19 11 at  ." Do you wish to delete this subdirectory? "
                0 at-name ;

: qweshn-del    ( -- t/f)
                get-attrib6
                14 16 \ curr-color @ 1 and 1 <> if swap then
                21 over at 9 ascii ▀ draw-line
                49 swap at 9 ascii ▀ draw-line
                21 over at 9 ascii ▄ draw-line
                49 swap at 9 ascii ▄ draw-line
                >norm 21 15 at 9 spaces  49 15 at 9 spaces
                22 15 50 15 true ?yes/no ;

: set-flash     ( -- )
                attrib @ $80 or attrib ! ;

: fill-screen   ( -- )
                curr-name 0! n-files @ n-catalogs @ + #fpage 0
                do i n>at at i over <
                  if
                   name-buf i @name name-buf swap ?4+ z-type
                  else
                   14 spaces
                  then
                loop drop first-file? @
                if 0 n>at at ."   No files.  "
                   2 stat-y at get-attrib10 33 spaces >norm
                then ;

: get-marker    ( n -- )
                dup n-catalogs @ n-files @ + 1- >
                if drop exit then             \ имя с этим номером недоступно
                curr-name @ n>at at           \ установить курсор
                name-buf curr-name @ @name
                name-buf swap ?4+ >norm z-type
                2 stat-y at get-attrib10
                name-buf over @name
                 if name-buf @long name-buf 4 + dup z-type
                    -rot 10 d.r ."  bytes. "
                 else name-buf dup  w@ $2E2E =
                        if   name-buf n>type 33 spaces
                        else name-buf z-type ."   Subdirectory.  "
                        then
                 then
                >rev over n>at at get-attrib4 count type >norm
                curr-name ! ;

: string>buf    ( a1,count,a2, -- )
                dup>r 1+ swap dup>r cmove r> r> c! ;

: .newpage      ( -- )
                ~offset 0! .at-path scoops-dir fill-screen ;

: f-delete      ( -- )
                first-file? @ ?exit
                savescr get-attrib2 messeg-window >norm
                ?newpage 0! name-buf curr-name @ @name
                if get-attrib2 qweshn-file qweshn-del dup ?newpage !
                  if ren-buf count>z ren-buf true sys-del
                     if get-attrib2 set-flash 5 9 at
                        ."   Attention! This file is marked read-only!    "
                        qweshn-del dup ?newpage !
                      if ren-buf drop-atr drop ren-buf
                         true sys-del drop
                      then
                     then
                  then
                else get-attrib2 name-buf w@ $2E2E =
                 if 18 12 at  ." Can't delete this directory!"
                   wait-esc >norm ?newpage 0!
                 else qweshn-cat qweshn-del dup ?newpage !
                   if ren-buf count>z ren-buf false sys-del
                      if get-attrib2 set-flash 5 9 at
                         ."   Attention! This subdirectory it is not empty! "
                         ." Can't delete!" 6 spaces ?newpage 0!
                         wait-esc >norm
                      then
                   then
                 then
                then
                restscr ?newpage @
                if .newpage 0 get-marker then ;

: mem-path      ( -- )
                savescr get-attrib2 messeg-window 18 12 at
                3 spaces ." Save current directory?"
                qweshn-del if path-buf old-path over c@ 1+ cmove then
                restscr  ;

: init-path-buf ( -- )
                [ ascii : ascii \ join ] literal path-buf 1+ w!
                curr-drv path-buf c! curr-path path-buf z>count ;

\ проверка правильности указания пути пользователем.
\ если не указан признак корневого каталога в path-buf добавляется
\ текущий путь. Если общая длинна пути превышает 65 байтов, то
\ устанавливается ошибка.

: scan-buf\     ( a -- n, a )
                count swap over +
                begin swap dup
                while 1- swap 1- dup c@ ascii \ = ?exit
                repeat swap ;

: scan-buf:     ( a -- n, a )
                count swap over +
                begin swap dup
                while 1- swap 1- dup c@ ascii : = ?exit
                repeat swap ;

: scan-buf:\    ( a -- n, a )
                count swap over +
                begin swap dup
                while 1- swap 1- dup w@ [ ascii : ascii \ join ] literal
                      = ?exit
                repeat swap ;

\ добавить к имени в буфере пути текущее устройство и путь,
\ если путь и устройство не указаны пользователем.

: ?addcurrent   ( -- )
                path-buf 2+ w@ [ ascii : ascii \ join ] literal = ?exit
                path-buf ren-buf PBUF-LONG cmove init-path-buf
                ren-buf count drop c@ ascii \ =
                if 2 path-buf c!
                else path-buf c@ 3 <>
                 if ascii \ path-buf count + c! path-buf incr then
                then
                ren-buf count >r path-buf count + r@ cmove r> path-buf c+! ;

\ если в буфере одиночный символ и он "\", то  установить корневой каталог
\ текущего устройства. Если в строке есть ":" и путь не указан,
\ то добавить текущий путь,

: ?error-path   ( -- t/f )
                path-buf count 1 = swap c@ ascii \ = and
                 if init-path-buf 3 path-buf c! then
                path-buf scan-buf: drop 0<> path-buf c@ 2 = and
                 if 0 init-path-buf
                 else
                   ?addcurrent path-buf dup count>z set-path path-buf z>count
                 then ;

: path-select   ( -- )
                savescr get-attrib5 messeg-window messeg-window
                 13 11 at
                ." Type in a new Directory Specification. "
                >norm 8 13 at 64 spaces 10 13 at ." Path: "
                begin
                  [ also hidden ]
                  17 13 path-buf PATH-LONG cursor-on
                  on> autoclear ['] >norm is >edattrib lineeditor cursor-off
                  [ previous    ]
                  drop path-buf count upper
                  path-buf scan-buf: drop
                  if path-buf 1+ c@ ascii A - change-drv then
                  ?error-path dup
                while drop set-flash 22 15 at
                  ."   This path is not correct!     "
                  >norm 7 emit
                repeat
                restscr 0= if .newpage 0 get-marker then ;

: mask-select   ( -- )
                savescr get-attrib5 messeg-window
                15 11 at ." Enter new mask from selection files."
                >norm 8 13 at 64 spaces
                mask-buf z>count 15 13 at  ."  Current mask: "
                [ also hidden ]
                31 13 mask-buf MASK-LONG 1- cursor-on
                on> autoclear ['] >norm is >edattrib lineeditor cursor-off
                [ previous    ]
                drop mask-buf count>z restscr .newpage 0 get-marker ;

\ для правильной работы функции в корневом каталоге надо убрать из буфера
\ имя устройства и \

: ?>root        ( a -- a/a+3 )
                dup scan-buf\ drop 2 = if 3 + then ;

: ren-select    ( -- )
                first-file? @ ?exit
                name-buf dup curr-name @ @name
                if   4 +  true                          \ Файл
                else w@ $2E2E = ?exit name-buf false     \ Каталог
                then
                savescr get-attrib5 messeg-window
                if   15 11 at ."    Rename the file:   "
                else 11 11 at ." Rename the subdirectory:  "
                then
                dup dup z>count count type
                ascii \ path-buf count dup>r + c! 1 path-buf c+!
                path-buf ren-buf over c@ 1+ cmove
                dup count >r path-buf count + r@ cmove
                r> path-buf c+!
                15 13 at ."    Enter new name:" >norm
                [ also hidden ]
                dup 37 13 rot 14 cursor-on on> autoclear
                ['] get-attrib5 is >edattrib ['] >norm >is @ >r
                ['] get-attrib5 is >norm
                lineeditor cursor-off r> is >norm
                [ previous    ]
                if dup count >r ren-buf count + r@ cmove r> ren-buf c+!
                   ren-buf path-buf dup c@ comp
                   if ren-buf count>z path-buf count>z
                      path-buf ?>root ren-buf ?>root sys-ren
                      if get-attrib1 5 9 at set-flash
                         ."    This name already exist!   "
                         >norm wait-esc
                      else scoops-dir
                      then path-buf z>count
                   then
                then drop r> path-buf c! restscr
                name-buf dup curr-name @ dup n>at at
                @name ?4+ >rev z-type >norm ;

\   Первоначально производится проверка имени, так как имя родительского
\ каталога переименовать нельзя. Затем:
\  1 сохранить экран
\  2 сохранить текущее значение длинны строки в буфере пути,
\  3 переслать путь в буфер для переименования,
\  4 вывести текущее имя и запрос нового имени файла,
\    (в случае отказа от переименования идти к 7)
\  5 сформировать ASCIIZ строки в буферах пути и буфере переименования
\  6 при неудачном переименовании дать сообщение об ошибке,
\  7 восстановить экран строку пути в буфере пути и закончить.

: change-cat    ( -- )
                path-buf count>z path-buf set-path drop path-buf z>count
                .newpage ;

: gotoroot      ( -- )
                3 path-buf c! change-cat 0 get-marker ;

: finde-name    ( -- )
                first-file? @ ?exit
                0 n-catalogs @ 0
                do name-buf dup i @name drop dup z>count
                   ren-buf dup c@ 1+ comp
                   0= if drop i leave then
                loop ;

: file-select   ( -- )
                first-file? @ ?exit
                name-buf curr-name @ @name
                if $5555 ?end-select ! 4 scoops-name exit then
                name-buf w@ $2E2E =
                if path-buf scan-buf\
                   ren-buf 14 cmove >r path-buf c@ r@ - 1- ren-buf c!
                   r> 3 max path-buf c! change-cat
                   finde-name get-marker
                else
                  name-buf z>count name-buf count >r path-buf count
                  dup 3 = if + else + ascii \ over c! 1+ path-buf incr then
                  r@ cmove r> path-buf c+! change-cat 0 get-marker
                then ;

: f-unselect    ( -- )
                $AAAA ?end-select ! ;

: find-liter    ( n -- n )
                first-file? @ ?exit
                upc old-litera @ over <>
                if   dup old-litera ! ~offset 0! 0 true
                else curr-name @ 1+ 0
                then  ?newpage ! >r
                begin n-files @ n-catalogs @ + r@ ~offset @ + 1+ <
                      if r>drop drop 7 emit exit then
                      name-buf dup r@ @name ?4+ c@ upc over <>
                while r> 1+ >r
                repeat drop r@ #fpage 1- r> <
                if  #fpage 1- - ~offset +! true ?newpage ! #fpage 1-
                then
                ?newpage @ if fill-screen then
                get-marker ;

: marker-left   ( -- )
                curr-name @ #frows - dup 0 <
                if drop else get-marker then ;

: marker-right  ( -- )
                first-file? @ ?exit
                curr-name @ #frows + n-files @ n-catalogs @ + 1- min
                #fpage 1- min get-marker ;

: nbuftype      ( t/f -- )
                name-buf swap ?4+ z-type ;

\ F-PC native port: after a scroll, redraw line r of every column, with the
\ lines between the columns (was written out for 3 columns of 19).
: redraw-row    ( r -- )
                #fcols 0
                ?do     i #frows * over +               ( r n )
                        dup n>at i
                        if      2dup swap 3 - swap at ."  │ "
                        then    at
                        name-buf swap @name nbuftype
                loop    drop ;

: marker-up     ( -- )
                curr-name @
                if curr-name @ 1- get-marker
                else ~offset @
                 if name-buf 0 @name 0 n>at at nbuftype
                    ~offset decr scr-down 0 redraw-row
                  0 get-marker
                 then
                then ;

: marker-down   ( -- )
                first-file? @ ?exit
                ~offset @ curr-name @ + 1+ n-files @ n-catalogs @ + =
                if exit then
                curr-name @ #fpage 1- =
                if name-buf #fpage 1- @name #fpage 1- n>at at nbuftype
                    ~offset incr scr-up
                    #frows 1- redraw-row
                  #fpage 1- get-marker
                else
                curr-name @ 1+ get-marker
                then ;

comment:

\ дополнительные функции

: in-page-up    ( -- )
                curr-name @ #frows / #frows * get-marker ;

: in-page-down  ( -- )
                first-file? @ ?exit
                #frows curr-name @ #frows mod - curr-name @ + 1-
                n-files @ n-catalogs @ + 1- min
                #fpage 1- min get-marker ;
comment;

: marker-home   ( -- )
                ~offset @
                if   ~offset 0! fill-screen then
                0 get-marker ;

: marker-end    ( -- )
                first-file? @ ?exit
                n-files @ n-catalogs @ + #fpage over <
                if #fpage - ~offset ! fill-screen #fpage then
                1- get-marker ;

: page-up       ( -- )
                ~offset @
                if
                 ~offset @ #fpage - 0<
                  if ~offset 0!
                  else #fpage negate ~offset +!
                  then fill-screen
                else
                then 0 get-marker ;

: page-down     ( -- )
                first-file? @ ?exit
                n-files @ n-catalogs @ + #fpage over <
                if #fpage ~offset +! ~offset @ #fpage + over >
                  if #fpage - ~offset !
                  else drop
                  then fill-screen #fpage
                then
                1- get-marker ;

128 funcarray d-functable ' d-functable value functable

   @> keysfuncptr         ' d-functable =: keysfuncptr

        ' marker-up     72 $80 or lkey!           \  
        ' marker-down   80 $80 or lkey!           \  
        ' marker-left   75 $80 or lkey!           \  
        ' marker-right  77 $80 or lkey!           \  
        ' page-up       73 $80 or lkey!           \ Pg Up
        ' page-down     81 $80 or lkey!           \ Pg Down
        ' marker-home   71 $80 or lkey!           \ Home
        ' marker-end    79 $80 or lkey!           \ End

\       ' .help         59 $80 or lkey!           \ F1
        ' page-up       60 $80 or lkey!           \ F2
        ' mask-select   61 $80 or lkey!           \ F3
        ' page-down     62 $80 or lkey!           \ F4
        ' path-select   63 $80 or lkey!           \ F5
        ' ren-select    64 $80 or lkey!           \ F6
        ' f-delete      66 $80 or lkey!           \ F8
        ' mem-path      67 $80 or lkey!           \ F9
        ' f-unselect    68 $80 or lkey!           \ F10
        ' f-unselect   113 $80 or lkey!           \ alt~F10

         =: keysfuncptr

create mousefuncarray
        ' marker-up      ,                        \  
        ' marker-down    ,                        \  
        ' marker-right   ,                        \  
        ' marker-left    ,                        \  
        ' marker-home    ,                        \ Home
        ' marker-end     ,                        \ End
        ' gotoroot       ,                        \ ^\ root
        ' noop           ,                        \ F1
        ' page-up        ,                        \ F2
        ' mask-select    ,                        \ F3
        ' page-down      ,                        \ F4
        ' path-select    ,                        \ F5
        ' ren-select     ,                        \ F6
        ' f-delete       ,                        \ F8
        ' mem-path       ,                        \ F9
        ' f-unselect     ,                        \ F10
        ' file-select    ,                        \ ENTER

: funcmouse     ( x,y -- )
                dup 4 20 between
                if
                  4 - cells mousefuncarray + @ execute drop
                else
                  2drop
                then ;

: getmouse     ( x,y -- )
                dup 3 list-bottom between
                if 2dup join x&y.mouse @ over x&y.mouse ! =
                   mousebutton 1 = and
                  if file-select 2drop x&y.mouse 0!
                  else 3 - swap 2 - 17 / #frows * + get-marker
                  then
                else 2drop
                then ;

: mouse-normir  ( -- )
                mousexy hide.ms dup 1 =
                if 2drop path-select exit then
                over panel-x >
                if funcmouse
                else getmouse
                then show.ms ;

defer nwfl-resize       \ F-PC native port: lay the window out again

: key-select    ( -- )
                ?resized if nwfl-resize exit then  \ F-PC native port: KEY?
                                \ may not report K-RESIZE, so check the size
                mousebutton if mouse-normir exit then
                key             \ 02/03/92 20:57 tjz changed from KEY-F
                dup k-resize =  \ F-PC native port: the terminal was resized
                if drop nwfl-resize exit then
                dup 127 >       \ 02/03/92 20:57 tjz changed from SPLIT
                if
                  $7F and functable execute
                else
                 case
                    13 of file-select endof             \ Enter
                    28 of gotoroot    endof             \ Ctrl~\
                    27 of f-unselect  endof             \ Esc
                          find-liter
                 endcase
                then show.ms ;

: dir-alloc     ( -- t/f )
                dir-seg 0=
                if true get-attrib5 messeg-window 17 13 at
                   ." Insufficent memory. Press any key." >norm  7 emit
\                    ." Мало памяти. Нажмите любую клавишу." >norm  7 emit
                    key drop
                 else 0
                 then ;

: dir-dealloc   ( -- )
                unpointer> dir-seg ;

: init-getfile  ( -- t/f ) \ true - переполнение озу инициализация невозможна.
                ~offset 0! find-buf 0! old-litera 0!
                dir-alloc
                init-path-buf
                dup 0=
                if path-buf old-path over c@ 1+ cmove
                   " *.*"  mask-buf string>buf mask-buf count>z
                   scoops-dir fill-screen  curr-name 0!
                then ;

: restore-path  ( -- )
                old-path 1+ c@ ascii A - change-drv old-path c@ 2 =
                if 3 old-path c! ascii \ old-path 3 + c! then
                old-path dup count>z set-path drop ;

: string-screen ( x,y -- )        \ F-PC native port: #FCOLS columns
                at #fcols 0 ?do ." │" 16 spaces loop
                ." │ " get-attrib10 ;

: ?stringscreen ( x,y -- )
                string-screen curr-color @ 1 = if 7 >fg then ;

: ?help         ( y -- f )      \ F-PC native port: is help line y inside?
                list-bottom > 0= ;

: draw-screen   ( -- )
         >norm 1  0 at right-x 1- ascii ═ draw-line ." ╒" right-x 0 at ." ╕"
         1  1 at ." │" get-attrib10 ."  Current path:"
         right-x 16 - spaces >norm ." │"
         1  2 at right-x 1- ascii ═ draw-line ." ╞"
         #fcols 1+ 1 ?do i 17 * 1+ 2 at ." ╤" loop right-x 2 at ." │"
         3 ?help if 1 3 ?stringscreen ." ▀▀▀▀▀▀" >norm ."     ────  ────   │" then
         4 ?help if 1 4 string-screen ."      " >norm ."   marker up       │" then
         5 ?help if 1 5 string-screen ."      " >norm ."   marker down     │" then
         6 ?help if 1 6 string-screen ."      " >norm ."   marker right    │" then
         7 ?help if 1 7 string-screen ."      " >norm ."   marker end      │" then
         8 ?help if 1 8 string-screen ."  Home " >norm ."   marker to home  │" then
         9 ?help if 1 9 string-screen ."  End  " >norm ."   marker to end   │" then
         10 ?help if 1 10 string-screen  "   ^\  " type >norm ."   set root        │" then
         11 ?help if 1 11 string-screen ."       " >norm ."     ────  ────   │" then
         12 ?help if 1 12 string-screen ."   F2  " >norm ."   page up         │" then
         13 ?help if 1 13 string-screen ."   F3  " >norm ."   change mask     │" then
         14 ?help if 1 14 string-screen ."   F4  " >norm ."   page down       │" then
         15 ?help if 1 15 string-screen ."   F5  " >norm ."   select path     │" then
         16 ?help if 1 16 string-screen ."   F6  " >norm ."   rename          │" then
         17 ?help if 1 17 string-screen ."   F8  " >norm ."   delete          │" then
         18 ?help if 1 18 string-screen ."   F9  " >norm ."   save path       │" then
         19 ?help if 1 19 string-screen ."  Esc  " >norm ."   cancel          │" then
         20 ?help if 1 20 string-screen ."  Enter" >norm ."   select          │" then
         21 ?help if 1 21 ?stringscreen ." ▄▄▄▄▄▄" >norm ."     ────  ────   │" then
         list-bottom 1+ 22 max 22 ?do           \ more lines than the help
                1 i string-screen >norm
                right-x panel-x - 2- spaces ." │"
         loop
         1 sep-y at panel-x 4 + ascii ─ draw-line ." ├"
         #fcols 1 ?do i 17 * 1+ sep-y at
                i 2 = i 3 = or if ." ┼" else ." ┴" then
         loop panel-x sep-y at ." ┤"
         ."   Other keys next file   " >norm ." │"
         1 stat-y at ." │" 33 spaces ." │" get-attrib10 ."  Time           "
         >norm ." │" panel-x 52 > if panel-x 53 - spaces ." │" then
         ."   starting with Letter.  "
         >norm ." │" 1 bot-y at right-x 1- ascii ═ draw-line ." ╘"
         35 bot-y at ." ╧" 52 bot-y at ." ╧"
         panel-x 52 > if panel-x bot-y at ." ╧" then
         right-x bot-y at ." ╛" ;

: (nwfl-resize) ( -- )  \ F-PC native port: K-RESIZE, lay the window out again
                nwfl-geometry >norm dark draw-screen .at-path
                ~offset @ curr-name @ +         \ keep the current name
                dup #fpage / #fpage * dup ~offset ! -
                fill-screen get-marker ;

' (nwfl-resize) is nwfl-resize

        also hidden also

: save-attrib   ( -- )
                [ ' >norm     >is ] literal @ [ attribs 0 cells + ] literal !
                [ ' >rev      >is ] literal @ [ attribs 1 cells + ] literal !
                [ ' >edattrib >is ] literal @ [ attribs 2 cells + ] literal !
                                     attrib @ [ attribs 3 cells + ] literal !
                                     base   @ [ attribs 4 cells + ] literal ! ;

: rest-attrib   ( -- )
                [ attribs 0 cells + ] literal @ is >norm
                [ attribs 1 cells + ] literal @ is >rev
                [ attribs 2 cells + ] literal @ is >edattrib
                [ attribs 3 cells + ] literal @ attrib !
                [ attribs 4 cells + ] literal @ base ! ;

: color0        ( -- )
                blue >bg green >fg ;

: color1        ( -- )
                red >bg white >fg ;

: color2        ( -- )
                green  >bg white >fg ;

: color3        ( -- )
                white >fg blue >bg ;

: color4        ( -- )
                ltgray >bg black  >fg ;

: color5        ( -- )
                brown  >bg black  >fg ;

: color6        ( -- )
                blue   >bg white  >fg ;

: color7        ( -- )
                red    >bg black  >fg ;

: color7'       ( -- )
                red    >bg ltgray >fg ;

: color8
                black  >bg ltgray >fg ;

: color9        ( -- )
                cyan   >bg black  >fg ;

: color10       ( -- )
                cyan   >bg white  >fg ;
\                green  >bg black  >fg ;

: norm-color    ( -- )
                ['] color0      is get-attrib1
                ['] color1      is get-attrib2
                ['] color3      is get-attrib4
                ['] color6      is get-attrib5
                ['] color7'     is get-attrib6
                ['] color10     is get-attrib10
                ['] color5      is >rev
                ['] color4      is >norm
                ;

: rev-color    ( -- )
                ['] color0      is get-attrib1
                ['] color1      is get-attrib2
                ['] color3      is get-attrib4
                ['] color6      is get-attrib5
                ['] color7      is get-attrib6
                ['] color10     is get-attrib10
                ['] color4      is >rev
                ['] color8      is >norm
                ;

: get-w/b       ( -- )
                ['] color8      is get-attrib1
                ['] color8      is get-attrib2
                ['] color8      is get-attrib4
                ['] color8      is get-attrib5
                ['] color8      is get-attrib6
                ['] color8      is get-attrib10
                ['] color4      is >norm
                ['] color8      is >rev
                ;

: get-b/w       ( -- )
                ['] color4      is get-attrib1
                ['] color4      is get-attrib2
                ['] color4      is get-attrib4
                ['] color4      is get-attrib5
                ['] color4      is get-attrib6
                ['] color4      is get-attrib10
                ['] color8      is >norm
                ['] color4      is >rev
                ;

: get-attrib    ( -- )
                curr-color @ 3 and normval reverseval =
                if 1 or else 2 and then dup curr-color !
                exec:
                rev-color norm-color get-b/w get-w/b ;

        previous previous previous previous definitions

: (getfile)     ( -- )
                [ also getvoc also hidden ]
                savecursor savescr \ записать куpсоp и экpан
                save> base decimal
                save-attrib get-attrib >norm cursor-off
                nosetcur @ true nosetcur !
                nwfl-geometry           \ F-PC native port: fit the screen
                draw-screen init-getfile 0=
                 if .at-path ?end-select 0!
                    cursor-off marker-home
                    begin .time-key key-select ?end-select @ until hide.ms
                 then
                dir-dealloc rest-attrib nosetcur !
                restore> base
                restscr restore-path
                ?end-select @ $5555 = if ren-buf true else 0 then
                restcursor
                [ previous previous ] ;

' (getfile) is getfile


\s : q     getfile if count type then cr ;

