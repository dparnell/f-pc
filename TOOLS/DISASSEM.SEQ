\ DISASSEM.SEQ  A disassembler for abstract-machine CODE words
\               (was: A disassembler for the 8086 by Charles Curley)
\                                                       F-PC native port

comment:

  Native port: there is no 8086 code to disassemble. CODE words are op
streams for the VM's abstract machine (kernel-design.md 5, vm/amops.def,
SRC/AMASM.SEQ), so this file now decodes those and prints them back in
AMASM syntax, ready to be assembled again:

        SEE <name>      a CODE word or a word made by a ;CODE defining word
                        now shows its abstract-machine code; SEE is hooked
                        through the deferred (SEE) used by DECOM.SEQ
        DIS <name>      the same listing with addresses and op cells
        ADIS ( addr -- )        list ops from addr
        DISASSEM ( addr -- )    same as ADIS (the old name)
        DIS: <name>     same as DIS (the old name)
        UN: <name>      same as SEE (the old name)

  Each op is a cell: op | a<<8 | b<<16 | c<<24, with an immediate cell
after it for LI, ADDI, the loads and stores and the branches. Branch
targets are absolute; inside the listing they become local labels (n L:).

  Where a listing ends: the word's ops run until a NEXT, or a BR, that is
past every branch target seen so far (the rule the JIT uses), and never
beyond the next word's code field, or HERE. A cell that is not a valid op
ends the listing.

  How a CODE word is recognised: its code token is above the built-ins
(like a DOES> word's) but no (DOES>) in list space is followed by it. A
;CODE defining word compiles "(DOES>) token" like DOES> does, but nothing
follows it in its list, so the cell after the pair starts another word's
list (or is XHERE); its ops follow the defining word's body (CFA + 8).
These tests are made in high level Forth; see the port notes for a VM
built-in that would make them exact.

  The 8086 version's relocation words (RELOC, HOMESEG, (T@) and friends)
and its own DUMP are gone: memory is flat and the system DUMP works on
any address.

comment;

ONLY FORTH ALSO DEFINITIONS
DECIMAL

VOCABULARY DISASSEMBLER

DISASSEMBLER ALSO DEFINITIONS

: COL   ( n -- )        \ go to column n
        #OUT @  - 0 MAX SPACES ;

: H.8   ( n -- )        \ n as 8 hex digits
        BASE @ >R HEX 0 <# # # # # # # # # #> TYPE R> BASE ! ;

\ ---- the op table, in vm/amops.def order ----------------------------------

37 CONSTANT #AMOPS

\ The names are counted strings, one after another; WORD leaves each at
\ HERE, and ALLOT keeps it.
: OPNAME,  ( | name -- )   BL WORD C@ 1+ ALLOT ;

CREATE OPNAMES
  OPNAME, NEXT,   OPNAME, LI,     OPNAME, MOV,    OPNAME, ADD,
  OPNAME, SUB,    OPNAME, AND,    OPNAME, OR,     OPNAME, XOR,
  OPNAME, MUL,    OPNAME, SHL,    OPNAME, SHR,    OPNAME, SAR,
  OPNAME, ADDI,   OPNAME, NOT,    OPNAME, NEG,    OPNAME, LD,
  OPNAME, LDB,    OPNAME, LDW,    OPNAME, ST,     OPNAME, STB,
  OPNAME, STW,    OPNAME, PUSH,   OPNAME, POP,    OPNAME, RPUSH,
  OPNAME, RPOP,   OPNAME, BR,     OPNAME, BZ,     OPNAME, BNZ,
  OPNAME, BEQ,    OPNAME, BNE,    OPNAME, BLT,    OPNAME, BGE,
  OPNAME, BLTU,   OPNAME, BGEU,   OPNAME, DIVMOD, OPNAME, UMULH,
  OPNAME, CMOVE,

\ Operand classes:  0 none           1 a imm         2 a b
\                   3 a b c          4 a b imm       5 a
\                   6 label          7 a label       8 a b label
CREATE OPCLASS
  0 C, 1 C, 2 C, 3 C, 3 C, 3 C, 3 C, 3 C, 3 C, 3 C,     \ NEXT .. SHR
  3 C, 3 C, 4 C, 2 C, 2 C, 4 C, 4 C, 4 C, 4 C, 4 C,     \ SHR .. STB
  4 C, 5 C, 5 C, 5 C, 5 C, 6 C, 7 C, 7 C, 8 C, 8 C,     \ STW .. BNE
  8 C, 8 C, 8 C, 8 C, 3 C, 3 C, 3 C,                    \ BLT .. CMOVE
ALIGN

13 CONSTANT #REGS

: .REG  ( r -- )        \ R0-R7 SP RP IP W UP
        2* " R0R1R2R3R4R5R6R7SPRPIPW UP" DROP + 2 -TRAILING TYPE SPACE ;

: >OPNAME ( op -- a )   OPNAMES SWAP 0 ?DO COUNT + LOOP ;

: OPCODE ( insn -- op )   $FF AND ;
: RA     ( insn -- a )    8 RSHIFT $FF AND ;
: RB     ( insn -- b )   16 RSHIFT $FF AND ;
: RC     ( insn -- c )   24 RSHIFT ;

: VALID? ( insn -- f )  \ a real op with real registers?
        DUP OPCODE #AMOPS U<   OVER RA #REGS U< AND
        OVER RB #REGS U< AND   SWAP RC #REGS U< AND ;

: CLASS  ( insn -- n )    OPCODE OPCLASS + C@ ;

: IMM?   ( insn -- f )    \ followed by an immediate cell?
        CLASS 1 SWAP LSHIFT
        [ 1 1 LSHIFT  1 4 LSHIFT OR  1 6 LSHIFT OR
          1 7 LSHIFT OR  1 8 LSHIFT OR ] LITERAL AND 0<> ;

: OPLEN  ( insn -- n )    \ bytes taken by the op at an address
        DUP VALID?
        IF      IMM? IF 8 ELSE 4 THEN
        ELSE    DROP 4
        THEN    ;

: BRANCH? ( insn -- f )   OPCODE 25 34 WITHIN ;

\ ---- walking the dictionary ----------------------------------------------

VARIABLE 'EACH

: EACH-CFA ( xt -- )    \ run xt ( cfa -- ) for every word in every vocabulary
        'EACH !
        VOC-LINK @
        BEGIN   ?DUP
        WHILE   DUP #THREADS CELLS - #THREADS 0
                DO      DUP I CELLS + @
                        BEGIN   ?DUP
                        WHILE   DUP >R LINK> 'EACH @ EXECUTE R> @
                        REPEAT
                LOOP    DROP @
        REPEAT  ;

VARIABLE NEAR   VARIABLE FROM

: (NEXT-CFA) ( cfa -- )
        DUP FROM @ U> OVER NEAR @ U< AND
        IF      NEAR !
        ELSE    DROP
        THEN    ;

: NEXT-CFA ( a -- a' )  \ the nearest code field above a, or HERE
        DUP FROM !  DUP HERE U< IF DROP HERE ELSE 1024 + THEN NEAR !
        ['] (NEXT-CFA) EACH-CFA  NEAR @ ;

VARIABLE LIST-AT   VARIABLE FOUND

: (LIST-START?) ( cfa -- )
        DUP @ CT-NEST =
        IF      >BODY @ LIST-AT @ = IF FOUND ON THEN
        ELSE    DROP
        THEN    ;

: LIST-START? ( a -- f ) \ does a colon definition's token list start at a?
        LIST-AT !  FOUND OFF
        ['] (LIST-START?) EACH-CFA  FOUND @ ;

\ ---- what kind of word is it? --------------------------------------------

: DOES-PAIR ( ct -- a | 0 )     \ the cell after a "(DOES>) ct" pair in
                                \ list space; as DOES-LIST in DECOM.SEQ
        XHERE ALIGNED CELL-
        BEGIN   DUP LIMIT U>
        WHILE   2DUP @ =
                IF      DUP CELL- @ ['] (DOES>) =
                        IF      NIP CELL+ EXIT
                        THEN
                THEN    CELL-
        REPEAT  2DROP 0 ;

: ;CODE-PAIR? ( a -- f )        \ a follows a "(DOES>) ct" pair: is it
                                \ a ;CODE?  (nothing of its list follows)
        DUP XHERE U< 0= IF DROP TRUE EXIT THEN
        LIST-START? ;

: AMWORD? ( cfa -- f )          \ a CODE word: its ops follow its CFA
        @ DUP FIRST-DOES-CT U<
        IF      DROP FALSE
        ELSE    DOES-PAIR 0=
        THEN    ;

: ;CODE-DEF ( cfa -- defcfa | 0 ) \ the ;CODE defining word of a word
        @ DUP FIRST-DOES-CT U< IF DROP 0 EXIT THEN
        DOES-PAIR ?DUP 0= IF 0 EXIT THEN
        DUP ;CODE-PAIR? 0= IF DROP 0 EXIT THEN
        2 CELLS - LIST>CFA ;

: >AMCODE ( cfa -- ops | 0 )    \ where the abstract-machine code of a
                                \ CODE word or ;CODE child starts
        DUP AMWORD? IF >BODY EXIT THEN
        ;CODE-DEF DUP IF 2 CELLS + THEN ;

\ ---- the end of an op stream and its labels ------------------------------

VARIABLE MAXT   VARIABLE LIM

\ CODEHIGH.SEQ's >H ... H> compiles  IP RPUSH,  IP list LI,  NEXT,  then
\ (after the high level list) a code field with its own code token,
\ followed by  IP RPOP,  and the rest of the CODE word.
$0A17 CONSTANT IP-RPUSH         $0A01 CONSTANT IP-LI
$0A18 CONSTANT IP-RPOP

: H>AT? ( a -- f )      \ is there an H> code field at a?
        DUP @ FIRST-DOES-CT U< 0= SWAP CELL+ @ IP-RPOP = AND ;

: AM-END ( start limit -- end )
\ Like the JIT's scan: stop after a NEXT or a BR that is past every
\ branch target, at a cell that is not an op, or at limit. A NEXT
\ followed by an H> code field goes on after it.
        LIM !  DUP MAXT !
        BEGIN   DUP LIM @ U<
        WHILE   DUP @ DUP VALID? 0= IF DROP EXIT THEN
                DUP BRANCH? IF OVER CELL+ @ MAXT @ UMAX MAXT ! THEN
                DUP OPLEN ROT + SWAP            ( pc' insn )
                OPCODE DUP 0= 2 PICK H>AT? AND
                IF      DROP CELL+              \ skip the code field
                ELSE    DUP 0= SWAP 25 = OR
                        OVER MAXT @ U> AND IF EXIT THEN
                THEN
        REPEAT  ;

: AM-RANGE ( start -- start end )
        DUP DUP NEXT-CFA AM-END ;

64 CONSTANT #LBLS
CREATE LBLS  #LBLS CELLS ALLOT
VARIABLE #LBL

: ADD-LBL ( a -- )
        #LBL @ 0
        ?DO     DUP LBLS I CELLS + @ = IF DROP UNDO EXIT THEN
        LOOP    #LBL @ #LBLS <
        IF      LBLS #LBL @ CELLS + !  #LBL INCR
        ELSE    DROP
        THEN    ;

: ?SWAP ( a -- )        \ order the cells at a and a+4
        DUP @ OVER CELL+ @ 2DUP U>
        IF      ROT DUP >R ! R> CELL+ !
        ELSE    2DROP DROP
        THEN    ;

: SORT-LBLS ( -- )
        #LBL @ 0 ?DO #LBL @ 1- 0 ?DO LBLS I CELLS + ?SWAP LOOP LOOP ;

: LBL# ( a -- n | -1 )  \ the local label number of address a
        #LBL @ 0
        ?DO     DUP LBLS I CELLS + @ = IF DROP I UNDO EXIT THEN
        LOOP    DROP -1 ;

VARIABLE LO   VARIABLE HI

: FIND-LBLS ( start end -- )    \ the branch targets inside [start, end]
        #LBL OFF  HI !  DUP LO !
        BEGIN   DUP HI @ U<
        WHILE   DUP @ DUP VALID?
                IF      DUP BRANCH?
                        IF      OVER CELL+ @ DUP LO @ HI @ 1+ WITHIN
                                IF ADD-LBL ELSE DROP THEN
                        THEN
                THEN    OPLEN +
        REPEAT  DROP SORT-LBLS ;

\ ---- printing ------------------------------------------------------------

0 VALUE SHOW-ADDR       \ true: addresses and op cells in the listing
VARIABLE PC             \ the op being shown

: .IMM  ( n -- )        \ small numbers in decimal, others in hex
        DUP -4096 65536 WITHIN
        IF      .
        ELSE    ." $" BASE @ >R HEX U. R> BASE !
        THEN    ;

: .TARGET ( a -- )      \ a local label, or an address outside the word
        DUP LBL# DUP 0<
        IF      DROP ." ( $" BASE @ >R HEX U. R> BASE ! ." ) "
        ELSE    . DROP
        THEN    ;

: XT? ( n -- f )        \ does n look like the CFA of a named word?
        DUP ALIGNED OVER = OVER LIMIT U< AND OVER 4096 U> AND
        IF      (>NAME) 0<>
        ELSE    DROP FALSE
        THEN    ;

: .LIVAL ( n -- )       \ LI,'s value: ' name for a code field
        DUP XT?
        IF      ." ' " >NAME .ID
        ELSE    .IMM
        THEN    ;

: .OPERANDS ( insn -- )
        DUP CLASS
        CASE
          1 OF  DUP RA .REG  PC @ CELL+ @ .LIVAL                        ENDOF
          2 OF  DUP RA .REG  DUP RB .REG                                ENDOF
          3 OF  DUP RA .REG  DUP RB .REG  DUP RC .REG                   ENDOF
          4 OF  DUP RA .REG  DUP RB .REG  PC @ CELL+ @ .IMM             ENDOF
          5 OF  DUP RA .REG                                             ENDOF
          6 OF  PC @ CELL+ @ .TARGET                                    ENDOF
          7 OF  DUP RA .REG  PC @ CELL+ @ .TARGET                       ENDOF
          8 OF  DUP RA .REG  DUP RB .REG  PC @ CELL+ @ .TARGET          ENDOF
        ENDCASE DROP ;

: .LABEL ( -- )         \ "n L:" if a branch goes to PC, in 8 columns
        #OUT @ PC @ LBL# DUP 0<
        IF      DROP
        ELSE    4 .R ."  L: "
        THEN    8 + COL ;

: .ADDR ( insn -- )     \ address and op cells
        SHOW-ADDR
        IF      PC @ H.8 2 SPACES  DUP H.8 SPACE
                DUP VALID? IF IMM? ELSE DROP FALSE THEN
                IF      PC @ CELL+ @ H.8
                ELSE    8 SPACES
                THEN    2 SPACES
        ELSE    DROP
        THEN    ;

: .INSN ( -- )          \ show the op at PC on a new line, and step past it
        CR PC @ @ DUP .ADDR .LABEL
        DUP VALID?
        IF      DUP .OPERANDS DUP OPCODE >OPNAME COUNT TYPE
        ELSE    ." $" DUP H.8 ."  ,   " ASCII \ EMIT ."  not an op"
        THEN    OPLEN PC +! ;

: >H?    ( -- f )        \ do the ops at PC start a >H ... H> group?
        PC @ DUP @ IP-RPUSH =
        OVER CELL+ @ IP-LI = AND
        OVER 3 CELLS + @ 0= AND
        SWAP 4 CELLS + H>AT? AND ;

: .TOKENS ( list end -- )       \ the words in a >H ... H> list, simply
        SWAP
        BEGIN   DUP @ 2 PICK <>
        WHILE   DUP @ >R CELL+
                R@ ['] (LIT) = R@ ['] <'> = OR
                IF      DUP @ .IMM CELL+
                ELSE    R@ ['] (.") =
                        IF      ASCII . EMIT ASCII " EMIT SPACE
                                COUNT 2DUP TYPE + ALIGNED ASCII " EMIT SPACE
                        ELSE    R@ >NAME .ID
                        THEN
                THEN    R>DROP
                #OUT @ COLS 16 - > IF CR 8 SPACES THEN
        REPEAT  2DROP ;

: .H-GROUP ( -- )               \ show a >H ... H> group, step past it
        CR PC @ @ .ADDR .LABEL ." >H "
        PC @ 2 CELLS + @  PC @ 4 CELLS + .TOKENS ." H>"
        6 CELLS PC +! ;

: (DIS) ( start end -- )        \ list the ops in [start, end)
        2DUP FIND-LBLS
        SWAP PC !
        BEGIN   PC @ OVER U<
        WHILE   >H? IF .H-GROUP ELSE .INSN THEN
                KEY? IF KEY DROP DROP EXIT THEN
        REPEAT  DROP
        PC @ LBL# 0< 0=         \ a label just past the end
        IF      CR .LABEL
        THEN    ;

: .AMCODE ( ops -- )            \ list a word's ops and END-CODE
        AM-RANGE (DIS) CR ." END-CODE " ;

: CODE-SEE ( cfa -- )           \ SEE a CODE word
        CR ." CODE " DUP >NAME .ID >BODY .AMCODE ;

: ;CODE-CHILD-SEE ( cfa defcfa -- )   \ SEE a word made by ;CODE
        CR SWAP >NAME .ID ." is made by " DUP >NAME .ID
        ." whose ;CODE part is:"
        2 CELLS + .AMCODE ;

: ;CODE-AT ( cfa -- a | 0 )     \ the "(DOES>) ct" pair of a ;CODE
                                \ defining word, in its token list
        DUP @ CT-NEST <> IF DROP 0 EXIT THEN
        >BODY @ DUP BODY-END SWAP
        ?DO     I @ ['] (DOES>) =
                IF      I CELL+ @ DUP FIRST-DOES-CT U< 0=
                        IF      DOES-PAIR DUP I 2 CELLS + =
                                IF      ;CODE-PAIR?
                                        IF      I UNDO EXIT
                                        THEN
                                ELSE    DROP
                                THEN
                        ELSE    DROP
                        THEN
                THEN
        CELL +LOOP 0 ;

DEFER OLD-SEE   ' (SEE) >IS @ IS OLD-SEE

: ;CODE-DEF-SEE ( cfa a -- )    \ SEE a ;CODE defining word: decompile
                                \ it with UNNEST in place of (DOES>),
                                \ then list the ;CODE part
        DUP @ >R  ['] UNNEST OVER !
        OVER OLD-SEE
        R> SWAP !
        CR ASCII \ EMIT ."  the ; above is ;CODE, followed by:"
        2 CELLS + .AMCODE ;

: AM-SEE ( cfa -- )             \ SEE, with abstract-machine code
        DUP AMWORD?      IF CODE-SEE EXIT THEN
        DUP ;CODE-DEF ?DUP IF ;CODE-CHILD-SEE EXIT THEN
        DUP ;CODE-AT  ?DUP IF ;CODE-DEF-SEE EXIT THEN
        OLD-SEE ;

' AM-SEE IS (SEE)

FORTH DEFINITIONS

: ADIS  ( addr -- )             \ disassemble abstract-machine code from addr
        [ DISASSEMBLER ]
        SAVE> SHOW-ADDR ON> SHOW-ADDR
        AM-RANGE 2DUP = IF CELL+ THEN   \ show at least one cell
        (DIS)
        RESTORE> SHOW-ADDR ;

: DISASSEM   ( addr -- )        \ the old name of ADIS
        ADIS ;

: DIS   ( | name -- )           \ disassemble a CODE word, with addresses
        ' [ DISASSEMBLER ] >AMCODE ?DUP 0=
        ABORT" Not a CODE word (try SEE)"
        ADIS ;

: DIS:  ( | name -- )           \ the old name of DIS
        DIS ;

: UN:   ( | name -- )           \ made with the un: nut, of course
        SEE ;

ONLY FORTH ALSO DEFINITIONS
