\ OBJECT.SEQ  From Forth Dimmensions, Volume 10, number 2  by Rick Hoselton
\                                                       F-PC native port

comment:

        Some object oriented words slightly modified by Tom Zimmer
        for use in F-PC.


        OFFSET  #BYTES  METHOD format
        0       4       next older borther METHOD pointer
        4       4       MESSAGE number
        8       8       METHOD's code: a code field (CT-NEST) and its
                        token list address, executed like a colon word


        OFFSET  #BYTES  OBJECT format
        0       4       father OBJECT address
        4       4       youngest son OBJECT address + 8
        8       4       next older brother OBJECT address + 8
        12      4       youngest METHOD address
        16      n       optional local data

        Native port: the offsets are in 4-byte cells (they were 2-byte),
        and a method's code is a nameless colon definition: a CT-NEST
        code field followed by the address of its token list (it was a
        JMP to NEST and a list segment).

comment;

only forth also definitions

anew objectstuff

\ Native port: the 8086 CODE version of ACTION jumped into the method's
\ code; the abstract machine has no EXECUTE, so the high level one is used.

: action        ( obj msg --- )
                swap    3 cells +
                begin   @ 2dup cell+ @ =
                until   2 cells + nip execute ;

variable 'msg
variable 'object

: act           ( pfa msg --- )
                2dup 'msg @ ! 'object ! action ;

: me            ( --- ?? )
                'object @ ;

: >object       ( rel-addr --- addr )
                me + ;

: >super        ( rel-addr --- addr )
                me @ + ;

: link,         ( addr --- )
                here over @ , swap ! ;

: object>       ( --- )
                'object link,
                0 ,
                1 cells >super   link,
                3 cells >super @  ,  ;

create master
                master 'object !
                object>
                1 cells >object 3 cells erase

: (method)      ( --- msg )
                create here does> act ;

: ?create       ( --- msg )
                >in @   defined
                if      nip >body
                else    drop >in ! (method)
                then    ;

: (method:)     ( --- )
                ?create
                3 cells >object  link, ,
                CT-NEST ,               \ a nameless colon definition:
                XALIGN XHERE ,          \ code field, then its list address
                !csp ] ;

(method:) anchor ." I don't understand" ;

' anchor >body cell+ 'msg !

(method:) method:       ( --- )
                (method:) ;

master method: object:  ( --- )
                create  object> ;

: .method       ( link --- )
                cr dup 9 u.r  dup @ 9 u.r
                cell+ @ dup 9 u.r  2 spaces body> >name .id ;

master method: .methods ( --- )
                base @ hex  3 cells >object
                begin   @ ?dup
                while   dup .method
                repeat  base ! ;

: .me           ( n --- )
                cr spaces me body> >name .id ;

master method: (.sons)  ( n --- )
                dup .me  1 cells >object
                begin   @ dup
                while   2dup 2 cells - (.sons)
                repeat  2drop ;

master method: .sons    ( --- )
                0  me (.sons) ;

master method: .one     ( --- )
                4 .me ;


cr .( The demonstration words follow the \S in OBJECT.SEQ.)  \ port: was "Type 140 load & 157 load"
\s
\ Demonstration stuff starts here.

\               ********** Vehicle ************

master object: vehicle

vehicle method: #wheels  4 cells >super @ ;

vehicle object: boat    0 ,
vehicle object: car     4 ,
vehicle object: tricycle 3 ,

car object: green-monster
boat object: queen-mary

\ green-monster #wheels .
\ queen-mary    #wheels .

\s

\               ********** Automobile **********

master object: automobile

automobile method: object: ( n1 --- )
                create object>          \ build links
                0 ,                     \ 16 = odometer milage
                0 ,                     \ 20 = odometer milage at last fillup
                0 ,                     \ 24 = gas in tank
                  , ;                   \ 28 = miles-per gallon

automobile method: drive  ( n1 --- )
                28 >object @ 24 >object @ * min \ gas * mpg = range
                dup 16 >object +!               \ increment odometer
                dup 28 >object @ / negate 24 >object +!
                ." I'm driving " . ."  miles " ;

automobile method: tell-gas ( --- )
                24 >object @ cr
                ." I have " . ." gallons in my tank " ;

automobile method: fill-gas ( n1 --- )
                24 >object +!  me tell-gas ;


 7 automobile object: racer             \ High performance, seven MPG.
23 automobile object: slow-poke         \ Low performance, twenty-three MPG.

                                        \ Some privacy for SLOW-POKE
                                        \ This shows that different objects
                                        \ can use the same MESSAGE name to
                                        \ produce different results.
slow-poke method: tell-gas cr ." It's a secret! " ; \ <ÄÄÄÄÄÄÄÄÄÄÄÄ¿
