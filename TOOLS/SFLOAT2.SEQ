\ F-PC native port: the CODE words are high level Forth (see the notes at
\ the top of SFLOAT1.SEQ).  FLN is computed with the VM's native doubles;
\ the logarithm tables (LOGTAB1, LOGTAB2) and the FLN+ and RENORM labels
\ that went with the 8086 code are gone.  Doubles are 64 bits.

DEFINED NOFLOATING NIP #IF NOFLOATING #THEN

ANEW FLOGSRC
\ LOADED,
\ PREFIX                \ F-PC native port: no 8086 assembler

: FCONSTANT   ( F: r -- )  \ When creating an FCONSTANT
              ( F: -- r )  \ When using a created FCONSTANT.
        CREATE  FPOP , , ,
        DOES>                   \ F-PC native port: was ;CODE
        DUP 2 CELLS + @ OVER CELL+ @ ROT @ FPUSH ;

: FVARIABLE   ( -- )       \ At creation time.
              ( -- addr )  \ At run time.
        VARIABLE  0 , 0 , ;

HEX
DAA2 C90F 4001 FPUSH FCONSTANT PI
17F8 B172 3FFF FPUSH FCONSTANT FLN2
         0 0 0 FPUSH FCONSTANT F0.0
   0 8000 4000 FPUSH FCONSTANT F1.0
D8A9 DE5B 3FFE FPUSH FCONSTANT FLOG10E          \ log base 10 of e = 1/ln(10)
8DDE 935D 4001 FPUSH FCONSTANT FLN10.0          \ log base e of 10
0000 A000 4003 FPUSH FCONSTANT F10.0
0000 8000 7FFF FPUSH FCONSTANT FINFINITY
0000 8000 3FFF FPUSH FCONSTANT F0.5

: F1.0+   ( F: r1 -- r2 )     F1.0 F+ ;

: F@   ( F: -- r ; addr -- )            \ F-PC native port: was CODE
        -6 FSP +!  FSP @ 6 CMOVE ;

: F!   ( F: r -- ; addr -- )            \ F-PC native port: was CODE
        FSP @ SWAP 6 CMOVE  6 FSP +! ;

: F,   ( F: r -- )
        HERE F#BYTES ALLOT F! ;

: 1/F   ( F: r1 -- r2 )
        F1.0 FSWAP F/ ;

ALSO HIDDEN ALSO        \ F-PC native port: ":" replaces the top
                        \ of the search order, keep HIDDEN under it
: FLOAT     ( F: -- r ; dbl -- )        \ F-PC native port: was CODE.
        DUP 0< 8000 AND >R  DABS        \ The 64-bit double is rounded
        2DUP D0=                        \ to the 32-bit significand.
        IF      2DROP R> DROP 0 0 (SFPUSH) EXIT
        THEN
        3FFF 40 + (NORM64) R> (RPACK) ;

PREVIOUS PREVIOUS

: IFLOAT   ( F: -- r ; n -- )   S>D FLOAT ;

ALSO HIDDEN ALSO        \ F-PC native port: for (SF@) (SF!)

\ F-PC native port: m shifted left by k (0..32) as a double.
: (SHL64)   ( m k -- lo hi )
        DUP 0= IF  DROP 0 EXIT  THEN
        DUP 20 = IF  DROP 0 SWAP EXIT  THEN
        2DUP LSHIFT ROT ROT 20 SWAP - RSHIFT ;

\ F-PC native port: DINTABS truncates |r| to a 64-bit double (it was 32
\ bits).  The flag is 0 if it fits in 63 bits, $7FFF if it needs all 64,
\ and negative if it overflows.
: DINTABS   ( F: r -- ; -- dbl flag )  \ For Positive arguments.
        FPOP 7FFF AND 3FFF -            \ Truncating.
        ROT ROT 10 LSHIFT OR SWAP       ( m E )
        OVER 0< 0= OVER 1 < OR
        IF      2DROP 0 0 0 EXIT  THEN  \ zero, or exponent <= 0
        DUP 40 >
        IF      DROP 0 SWAP 8000 SX>N EXIT      \ overflow
        THEN
        DUP 40 = >R
        DUP 20 >
        IF      20 - (SHL64)            \ shift m left in a double
        ELSE    20 SWAP - RSHIFT 0
        THEN
        R> IF  7FFF  ELSE  0  THEN ;

WARNING @ WARNING OFF

: FIX   ( F: r -- ; -- d )
        FDUP0<
        IF    FABS F0.5 F+ DINTABS >R DNEGATE R>
        ELSE  F0.5 F+ DINTABS
        THEN 0<
        IF     [ LAST @ NAME> ] LITERAL 2 FPERR
        THEN ;

: INT    ( F: r -- ; -- d )
        FDUP0<
        IF    DINTABS DUP 0<
              IF   [ LAST @ NAME> ] LITERAL 2 FPERR
              ELSE
                    IF   [ LAST @ NAME> ] LITERAL 2 FPERR
                    THEN
              THEN
              DNEGATE
        ELSE  DINTABS DUP
              IF    [ LAST @ NAME> ] LITERAL 2 FPERR
              ELSE  DROP
              THEN
        THEN ;

WARNING !

\ F-PC native port: a triple is three 32-bit cells now (96 bits); the
\ number may have up to 96 integer bits.
: TINTA   ( F: r -- ; -- lo mid hi )  \ Convert a floating number to
        FPOP 7FFF AND 3FFF -            \ triple integer.
        ROT ROT 10 LSHIFT OR SWAP       ( m E )
        DUP 1 <
        IF      2DROP 0 0 0 EXIT  THEN
        DUP 60 >
        IF      OVER 0<                 \ Test for unnormalized number (zero)
                IF      2DROP [ LAST @ NAME> ] LITERAL 2 FPERR 0 0 0 EXIT
                THEN    2DROP 0 0 0 EXIT
        THEN
        DUP 20 >
        IF      DUP 40 >
                IF      40 - (SHL64) 0 ROT ROT          ( 0 mid hi )
                ELSE    20 - (SHL64) 0                  ( lo mid 0 )
                THEN
        ELSE    20 SWAP - RSHIFT 0 0
        THEN ;

: FINT   ( F: r1 -- r2 )     \ Set true fractional bits to zero.
        FSP @ (SF@) OVER 0< 0=          \ F-PC native port: was CODE
        IF      2DROP 0 0 FSP @ (SF!) EXIT  THEN        \ unnormalized: zero
        7FFF AND 3FFF -                 ( m E )
        DUP 1 <
        IF      2DROP 0 0 FSP @ (SF!) EXIT  THEN        \ exponent <= 0
        DUP 20 <
        IF      -1 SWAP 20 SWAP - LSHIFT AND            \ mask
                FSP @ (SF@) NIP FSP @ (SF!)
        ELSE    2DROP
        THEN ;

PREVIOUS PREVIOUS

ALSO HIDDEN DEFINITIONS

\ F-PC native port: RENORM (a label used by the CODE words) is gone.

: F**+N     ( F: r1 -- r2 ; n -- )
        7FFF AND >R F1.0
        BEGIN R@ 1 AND
              IF   FOVER F*  THEN
              R> 2/ DUP
        WHILE >R FSWAP FDUP F* FSWAP
        REPEAT
        DROP FNIP ;

PREVIOUS DEFINITIONS

: F**N     ( F: r1 -- r2 ; n -- )  \ Floating number raised to integer power.
        DUP 0<
        IF    ABS [ ALSO HIDDEN ] F**+N F1.0 FSWAP F/
        ELSE  F**+N
        THEN ;
PREVIOUS

: F**N*    ( F: r1 r2 -- r3 ; n -- )  \ Raise r2 to nth power and
        [ ALSO HIDDEN ]
        DUP 0<                        \ and multiply by r1.
        IF      ABS F**+N F/
        ELSE    F**+N F*
        THEN ;
PREVIOUS

DECIMAL
: D2**N   ( n1 -- lo hi )       \ F-PC native port: 64-bit doubles
        DUP 32 <
        IF      1 SWAP LSHIFT 0
        ELSE    DUP 64 <
                IF      32 - 1 SWAP LSHIFT 0 SWAP
                ELSE    DROP 0 0
                THEN
        THEN ;

DECIMAL
HEX

\ Floating division with partial remainder.
\    The division routine that follows is based on the work of Roedy Green,
\    the author of BBL/Abundance.

\ F-PC native port: F/PREM was CODE.  The quotient q = trunc(r1/r2) is an
\ integer, left unnormalized as the CODE did: if it fits in 32 bits its
\ significand is q itself and its exponent is $401F (so FPOP 401F = tests
\ for that); otherwise it holds the top 32 bits of q.  The remainder
\ r1 - q*r2 is exact (normalized here).  Long division, one bit a step.
\ A quotient of more than 64 bits is just r1/r2 with remainder 0, so that
\ F. can still print a huge number in E format.

ALSO HIDDEN DEFINITIONS
2VARIABLE PREM-Q

: (PREM-QUOT)   ( ud s -- )     \ push the integer quotient ud
        >R  DUP 0=                      \ fits 32 bits
        IF      DROP 401F R> OR (SFPUSH) EXIT
        THEN    401F 20 +               ( lo hi e )
        BEGIN   OVER 0< 0=
        WHILE   >R D2* R> 1-
        REPEAT  NIP R> OR (SFPUSH) ;
PREVIOUS DEFINITIONS

ALSO HIDDEN ALSO

: F/PREM     ( F: r1 r2 -- urrem urquot )  \ Results are unnormalized.
        [ LAST @ NAME> ] LITERAL FPOP-CFA !
        (OPS2)
        M2 @ 0< 0=                      \ Divide by zero
        IF      M1 @ E1 @ S1 @ OR (SFPUSH)      \ Remainder = numerator
                0 -1 (SFPUSH) FPOP-CFA @ 1 FPERR EXIT
        THEN
        M1 @ 0< 0=                      \ Treat unnormalized numerator as 0
        IF      0 0 (SFPUSH) 0 401F (SFPUSH) EXIT
        THEN
        E1 @ E2 @ - DUP 0<              \ r1 < r2
        IF      DROP M1 @ E1 @ S1 @ OR (SFPUSH)
                0 401F S1 @ S2 @ XOR OR (SFPUSH) EXIT
        THEN
        DUP 3F >                        \ Quotient over 64 bits: then it
        IF      DROP 0 0 (SFPUSH)       \ is just r1/r2 (normalized, so its
                M1 @ E1 @ S1 @ OR (SFPUSH)      \ exponent is > $401F) and
                M2 @ E2 @ S2 @ OR (SFPUSH)      \ the remainder is taken
                F/ EXIT                 \ as 0.  (The CODE gave an
        THEN                            \ overflow error.)
        M1 @ 0 0. PREM-Q 2!             ( d R )
        2DUP M2 @ 0 DU< 0=
        IF      M2 @ 0 D-  1. PREM-Q 2!  THEN
        ROT 0 ?DO
                D2*  PREM-Q 2@ D2* PREM-Q 2!
                2DUP M2 @ 0 DU< 0=
                IF      M2 @ 0 D-  PREM-Q 2@ 1 0 D+ PREM-Q 2!  THEN
        LOOP                            ( R: R < M2 )
        DROP ?DUP                                       \ remainder
        IF      0 SWAP E2 @ (NORM64) S1 @ (RPACK)
        ELSE    0 0 (SFPUSH)
        THEN
        PREM-Q 2@ S1 @ S2 @ XOR (PREM-QUOT) ;           \ quotient

PREVIOUS PREVIOUS

\ F-PC native port: the tables of logarithms (LOGTAB1, LOGTAB2) and the
\ FLN+ label were used only by the 8086 FLN.

ALSO HIDDEN ALSO

: FLN   ( F: r1 -- r2 )   \ Natural logarithm function.
        (SFPOP) DUP 8000 AND            \ F-PC native port: the logarithm
        IF      2DROP 4                 \ is computed in double precision
        ELSE    OVER 0<                 \ (NF-LN in SFLOAT1.SEQ).
                IF      NF-LN EXIT
                THEN    2DROP 8         \ Zero argument for FLN
        THEN
        -1 -1 (SFPUSH)                  \ Set result to largest negative number.
        [ LAST @ NAME> ] LITERAL SWAP FPERR ;

\ End of Logarithm Function.

PREVIOUS PREVIOUS

: FLOG     ( F: r1 -- r2 )
        FLN FLOG10E F* ;
HEX

\ F-PC native port: F/LN2 was a CODE multiply by 1/ln2 = $B8AA3B29 * 2^-31
3B29 B8AA 4000 FPUSH FCONSTANT (1/LN2)

: F/LN2     ( F: r -- r/ln2 )    \ Divide by natural log of 2
        (1/LN2) F* ;

\ End of F/LN2
