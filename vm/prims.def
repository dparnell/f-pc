/* prims.def -- built-in code tokens.
 *
 * PRIM(id, "NAME", flags)   inline in the dispatch loop (vm.c)
 * CPRIM(id, "NAME", flags)  C function p_<id>(vm_t*), registers synced
 *
 * The ORDER IS THE TOKEN NUMBERING. Images record built-in names, so tokens
 * may be renumbered, but keep runtime handlers first.
 */

/* ---- code-field handlers (no dictionary entry) --------------------------- */
PRIM(INVALID,     "(INVALID)",   F_NOHEAD)
PRIM(NEST,        "(NEST)",      F_NOHEAD)
PRIM(DOVAR,       "(DOVAR)",     F_NOHEAD)
PRIM(DOCONST,     "(DOCONST)",   F_NOHEAD)
PRIM(DOVALUE,     "(DOVALUE)",   F_NOHEAD)
PRIM(DODEFER,     "(DODEFER)",   F_NOHEAD)
PRIM(DOUSER,      "(DOUSER)",    F_NOHEAD)
PRIM(DOUSERDEFER, "(DOUSERDEFER)", F_NOHEAD)
PRIM(HALT,        "(HALT)",      0)

